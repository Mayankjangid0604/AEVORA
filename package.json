{
  "name": "aevora",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@9.5.1",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:migrate": "npx prisma migrate deploy --schema=packages/database/prisma/schema.prisma",
    "db:local:setup": "node packages/database/local-setup.js",
    "db:seed": "npx ts-node -P packages/database/tsconfig.json packages/database/prisma/seed.ts",
    "set-chairman-password": "node packages/database/update-chairman-password.js",
    "preflight": "node infrastructure/scripts/preflight-check.js",
    "preflight:prod": "node infrastructure/scripts/preflight-check.js --target production",
    "test:preflight": "node --test infrastructure/scripts/preflight-check.spec.js"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "imap": "^0.8.19",
    "mailparser": "^3.9.28",
    "pg": "^8.23.0"
  }
}
