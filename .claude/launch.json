{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aevora-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=@aevora/web"
      ],
      "port": 3000
    },
    {
      "name": "aevora-api-safe",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--workspace=@aevora/api"
      ],
      "env": {
        "AEVORA_ENV_OVERRIDE": "../../scripts/safe-local.env"
      },
      "port": 13000
    },
    {
      "name": "aevora-api-e2e",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:prod",
        "--workspace=@aevora/api"
      ],
      "env": {
        "AEVORA_ENV_OVERRIDE": "scripts/e2e-local.env"
      },
      "port": 4011
    }
  ]
}