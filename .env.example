# Database
POSTGRES_USER=aevora
POSTGRES_PASSWORD=secret
POSTGRES_DB=aevoradb
DATABASE_URL="postgresql://aevora:secret@localhost:5432/aevoradb?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API & Web
PORT_API=13000
PORT_WEB=3001

# Lead Generation (Phase 42 Step 2) — mock leads unless LEAD_GEN_PROVIDER_ENABLED=true and key set
LEAD_GEN_PROVIDER_ENABLED=false
GOOGLE_PLACES_API_KEY=
LEAD_GEN_CATEGORIES=restaurant,salon,gym,retail_shop,coaching_center
# LEAD_GEN_LOCATION is no longer read (see LEAD_GEN_LOCATIONS below).
# Global fallback radius in metres (100–500000). Per-company LeadGenConfig.radiusM overrides this.
LEAD_GEN_RADIUS_M=50000
# Global fallback cooldown between auto-runs in hours (0.1–168). Per-company LeadGenConfig.intervalHours overrides this.
LEAD_GEN_INTERVAL_HOURS=6

# Sales Outreach (Phase 42 Step 3) — SMTP used when SMTP_HOST set. OUTREACH_ENVIRONMENT=SANDBOX never sends real mail;
# PRODUCTION still redirects to TEST_EMAIL_RECIPIENT unless ENABLE_REAL_PRODUCTION_SENDING=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
OUTREACH_FROM_NAME=AEVORA Team
OUTREACH_ENVIRONMENT=SANDBOX
OUTREACH_FOLLOWUP_DAYS=3
SALES_BATCH_SIZE=5
CHAIRMAN_NAME=Your Name
COMPANY_NAME=Your Company

# Delivery & Payments (Phase 42 Step 4)
# Base for client sample links: {PUBLIC_API_URL}/delivery/samples/{projectId}
PUBLIC_API_URL=http://localhost:13000
PAYMENT_REMINDER_DAYS=3
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: {PUBLIC_API_URL}/delivery/webhooks/razorpay (event: payment_link.paid)
RAZORPAY_WEBHOOK_SECRET=
BANK_TRANSFER_INSTRUCTIONS=UPI: yourname@upi

# Survival / Financial Kill Switch (Phase 42 Step 5) — defaults for new SurvivalConfig rows
MIN_BALANCE_PAISE=50000
WARNING_BALANCE_PAISE=200000

# Ventures (Phase 42 Step 7)
VENTURE_MAX_TEAM=5

# Autonomous business loop (Phase 42 Step 10) — real-time throttle for survival → lead gen → sales → delivery → payments
BUSINESS_LOOP_INTERVAL_MS=60000

# CEO (Phase 43) — at most one review per simulation hour, and no more often than this many real minutes
CEO_REVIEW_MIN_INTERVAL_MIN=15
# CEO hiring & project staffing — the CEO hires only what open client projects need, reuses idle people first,
# and never puts more people in a room than it has desk chairs (the 3D office reports its chairs when it loads).
# Full room → the Chairman gets an email + Assistant message to add desks or a floor.
DEFAULT_ROOM_CHAIRS=6   # used only until the 3D office has been opened once
MAX_HEADCOUNT=100       # runaway backstop only

# Chairman notifications by email (hires, seat shortages, CEO questions, payments, interested leads).
# Uses the SMTP_* settings above. WhatsApp/call later.
CHAIRMAN_NOTIFY_EMAIL=you@example.com
CHAIRMAN_EMAIL_NOTIFICATIONS=true

# Real leads: google (needs GOOGLE_PLACES_API_KEY) | osm (free OpenStreetMap businesses, no key) | mock
LEAD_GEN_SOURCE=osm
# National + international: each run takes the next N cities from this list (default: Indian metros + Dubai, London,
# Toronto, Sydney, Singapore, New York, Berlin, Nairobi). LEAD_GEN_LOCATION (single city) is no longer used.
# LEAD_GEN_LOCATIONS=Jaipur, India; Mumbai, India; Dubai, United Arab Emirates; London, United Kingdom
LEAD_GEN_LOCATIONS_PER_RUN=2
# Testing: every lead's email is replaced with this inbox (real email kept in the lead notes).
LEAD_DEMO_EMAIL=you@example.com

# Authentication (REQUIRED)
JWT_SECRET=change-this-to-a-random-32-char-string

# Local Ollama (REQUIRED for AI features)
OLLAMA_BASE_URL=http://localhost:11434
# 5-role model routing. AEVORA_MODEL_* takes precedence over OLLAMA_*_MODEL (backward compat).
# Defaults: phi4:latest (14.7B) for heavy tasks, qwen2.5:7b (7.6B) for lighter tasks.
AEVORA_MODEL_FAST=qwen2.5:7b
AEVORA_MODEL_NORMAL=gemma3:12b
AEVORA_MODEL_COMPLEX=qwen3:14b
AEVORA_MODEL_CODING=qwen3-coder:30b
AEVORA_MODEL_STRATEGIC=qwen3:14b

# WhatsApp Business API (optional — without these, WhatsApp messages are pushed to chairman's device)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Gemini API (optional — used for important tasks when local models are insufficient)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude API (optional — enables tiered model escalation: sonnet/opus/fable)
ANTHROPIC_API_KEY=


# Email sandbox safety net
TEST_EMAIL_RECIPIENT=you@example.com
ENABLE_REAL_PRODUCTION_SENDING=false

# Vercel frontend URL (set this after Vercel deploy)
NEXT_PUBLIC_API_URL=http://localhost:13000
NEXT_PUBLIC_WS_URL=http://localhost:13000

# Phase 44 - model tiers & briefs
CEO_MODEL=qwen3:14b
CEO_MODEL_COMPLEX=qwen3:14b
OLLAMA_MODEL=gemma3:12b
# MODEL_TIER_1 is not read by code (tier 1 = local Ollama CEO_MODEL)
# MODEL_TIER_1=phi4
MODEL_TIER_2=claude-sonnet-5
MODEL_TIER_3=claude-opus-5-5
MODEL_TIER_4=claude-fable-5-1
BUDGET_TIER_1_MAX=500000
BUDGET_TIER_2_MAX=1000000
BUDGET_TIER_3_MAX=2000000
BRIEF_OUTPUT_DIR=briefs/pending
# CLAUDE_CODE_ENABLED is not read by code
# CLAUDE_CODE_ENABLED=true

# Gmail Inbox Reader (Phase 44 Part 7) — reads replies from leads every 10 minutes.
# Step 1: Gmail → Settings → See all settings → Forwarding and POP/IMAP → Enable IMAP → Save
# Step 2: Set INBOX_ENABLED=true
# Step 3: SMTP_USER / SMTP_PASS (Gmail app password) are reused; set IMAP_USER / IMAP_PASS only to override.
INBOX_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# Webhook HMAC secrets (REQUIRED - API refuses to start without them)
WEBHOOK_SECRET_PROD=
WEBHOOK_SECRET_SIM=

# Service-to-service integration (n8n, cron schedulers). Generate with: openssl rand -hex 32
# INTEGRATION_API_KEY=

# ── Added during stabilization: vars read by code but missing above ─────────────
# Empty ones are commented out on purpose: an empty value can override a code default.
# Runtime
NODE_ENV=development
# PORT overrides PORT_API when set
# PORT=
# Extra CORS origins, comma-separated (production only)
# ALLOWED_ORIGINS=
NEXT_PUBLIC_APP_URL=http://localhost:3001
PORTAL_URL=http://localhost:3001
# Mobile app (apps/mobile/.env): your PC's LAN IP
EXPO_PUBLIC_API_URL=http://10.0.2.2:13000

# Local model (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=120000
OLLAMA_MAX_CONCURRENT_REQUESTS=1

# Kill switches / feature flags (defaults shown = safe)
AGENT_WORK_CYCLES=true
WE_WORLD_ENGINE=true
SALES_AUTO_PROCESS=false
CEO_COMPLEX_RETHINK=false
# Approval-gated features stay disabled unless set to "enabled"
# BU_CAPITAL_REQUEST_APPROVAL=
# CA_ALLOCATION_EXECUTION=
# CA_PROPOSAL_APPROVAL=
# GO_ENTITY_APPROVAL=

# Workers / timing
# BACKGROUND_STEP_WAIT_MS=
# CHAIRMAN_MAIL_POLL_MS=
INBOX_CHECK_MINUTES=10
# DEMO_TTL_DAYS=
DEFAULT_ROLE_SEATS=6

# Lead-gen geo (free OSM services; override only for self-hosted)
# NOMINATIM_URL=
# OVERPASS_URL=
# LEAD_GEN_LOCATIONS=

# Email (optional providers; SMTP_* above is the default path)
# FROM_EMAIL=
# SENDGRID_API_KEY=

# Voice (ElevenLabs optional; leave empty to use browser speech)
# TTS_PROVIDER=
# TTS_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=
# Per-department ElevenLabs voice IDs (optional)
# EL_VOICE_DEFAULT=
# EL_VOICE_CEO=
# EL_VOICE_ASSISTANT=
# EL_VOICE_ADMIN=
# EL_VOICE_FINANCE=
# EL_VOICE_HR=
# EL_VOICE_IT=
# EL_VOICE_LEGAL=
# EL_VOICE_MARKETING=
# EL_VOICE_OPS=
# EL_VOICE_PRODUCT=
# EL_VOICE_RD=
# EL_VOICE_RESEARCH=
# EL_VOICE_SALES=
# EL_VOICE_SUPPORT=

# Research + demo-site deploys (optional)
# RESEARCH_API_KEY=
# VERCEL_API_TOKEN=
# VERCEL_TEAM_ID=

# Company contact details used in client emails, invoices and AI prompts (placeholders — put real ones in .env).
# Client-facing sends fail with a clear error if name/email/phone are missing. COMPANY_EMAIL falls back to SMTP_USER.
COMPANY_EMAIL=hello@example.com
COMPANY_PHONE=+910000000000
COMPANY_ADDRESS=Your City, State, India

# Boardroom news channel (item 37): a YouTube *embed* URL of an official live business channel, e.g.
#   https://www.youtube.com/embed/live_stream?channel=<CHANNEL_ID>
# Next.js reads NEXT_PUBLIC_* from apps/web/.env.local — put it there. Empty = the Boardroom screen explains how to set it.
# NEXT_PUBLIC_BOARDROOM_NEWS_URL=
