# Journey A override (AEVORA_ENV_OVERRIDE=scripts/e2e-local.env). Disposable infra only — never 5433/5432/6379.
# Nothing here is a secret: the DB/Redis are throwaway containers bound to localhost.
DATABASE_URL=postgresql://postgres:e2e_local_only@localhost:5444/aevora_e2e?schema=public
REDIS_URL=redis://localhost:6380/0
PORT_API=4011
AEVORA_SAFE_MODE=true
OUTREACH_ENVIRONMENT=SANDBOX
ENABLE_REAL_PRODUCTION_SENDING=false
SMTP_HOST=
SENDGRID_API_KEY=
CHAIRMAN_EMAIL_NOTIFICATIONS=false
CHAIRMAN_NOTIFY_EMAIL=
INBOX_ENABLED=false
IMAP_HOST=
LEAD_GEN_PROVIDER_ENABLED=false
GOOGLE_PLACES_API_KEY=
WHATSAPP_API_TOKEN=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
REAL_PROVIDER_CALL=false
SALES_AUTO_PROCESS=false
AEVORA_MODEL_FAST=qwen2.5:7b
AEVORA_MODEL_NORMAL=qwen2.5:7b
