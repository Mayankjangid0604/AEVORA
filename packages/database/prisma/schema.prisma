  deploymentType       String        @default("API")
  costPerInputTokenMc  Int           @default(0)
  costPerOutputTokenMc Int           @default(0)
  p50LatencyMs         Int?
  p95LatencyMs         Int?
  reliabilityScore     Int           @default(100)
  safetyMetadata       Json          @default("{}")
  metadata             Json          @default("{}")
  registeredBy         String
  isAdvisory           Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  company      Company                @relation("MpModelCompany", fields: [companyId], references: [id])
  provider     MpProvider             @relation(fields: [providerId], references: [id])
  capabilities MpModelCapability[]
