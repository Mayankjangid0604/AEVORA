  VALIDATING
  VALIDATED
  PLANNING
  IN_DEVELOPMENT
  TESTING
  SECURITY_REVIEW
  AWAITING_APPROVAL
  APPROVED
  RELEASED
  LAUNCHED
  ACTIVE
  DEPRECATED
  RETIRED
}

enum PfIdeaStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VALIDATED
  REJECTED
  CONVERTED
}

enum PfReleaseEnv {
  DEVELOPMENT
  TEST
  STAGING
  PRODUCTION
}

enum PfLaunchStatus {
  PLANNED
  READY
  LAUNCHED
  ROLLED_BACK
}

enum PfSecuritySeverity {
  INFO
  LOW
