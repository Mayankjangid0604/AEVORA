  @@unique([companyId, name])
}

model MpFallbackChain {
  id            String   @id @default(uuid())
  companyId     String
  sourceModelId String
  targetModelId String
  priority      Int      @default(1)
  conditions    Json     @default("{}")
  isActive      Boolean  @default(true)
  createdBy     String
  createdAt     DateTime @default(now())

  company     Company @relation("MpFallbackChainCompany", fields: [companyId], references: [id])
  sourceModel MpModel @relation("FallbackFrom", fields: [sourceModelId], references: [id])
  targetModel MpModel @relation("FallbackTo", fields: [targetModelId], references: [id])

  @@unique([companyId, sourceModelId, targetModelId])
