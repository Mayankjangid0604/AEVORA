enum TrainingMethod {
  SUPERVISED_FINE_TUNING
  ADAPTER_TRAINING
  PARAMETER_EFFICIENT_TRAINING
  EVALUATION_ONLY
  SIMULATED_TRAINING
}

enum ModelTrainingStatus {
  PLANNED
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
  RESOURCE_LIMIT
}

model TrainingConfiguration {
  id                 String         @id @default(uuid())
  companyId          String
  researchProjectId  String
  name               String
  description        String
  baseModel          String?
  baseModelVersionId String?
  datasetVersions    Json           @default("[]") // Array of dataset version IDs
  method             TrainingMethod @default(SIMULATED_TRAINING)
  configuration      Json           @default("{}")
  hyperparameters    Json           @default("{}")
  contextConfig      Json           @default("{}")
  tokenizerConfig    Json           @default("{}")
  evaluationConfig   Json           @default("{}")
  resourceLimits     Json           @default("{}")
  maxRuntimeMs       Int?
  maxComputeUnits    Int?
  creatorId          String
  status             String         @default("ACTIVE")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  company         Company         @relation(fields: [companyId], references: [id])
  researchProject ResearchProject @relation(fields: [researchProjectId], references: [id])
  runs            TrainingRun[]
}

model TrainingRun {
  id                  String              @id @default(uuid())
  companyId           String
  researchProjectId   String
  configurationId     String
  baseModelVersionId  String?
  datasetVersions     Json                @default("[]")
  status              ModelTrainingStatus @default(PLANNED)
  executor            String
  startedAt           DateTime?
  completedAt         DateTime?
  resourceAllocation  Json                @default("{}")
  resourceConsumption Json                @default("{}")
  metricsSummary      Json                @default("{}")
  failureReason       String?
  reproducibilityData Json                @default("{}")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  configuration       TrainingConfiguration @relation(fields: [configurationId], references: [id])
  attempts            TrainingRunAttempt[]
  artifacts           ModelArtifact[]
  TrainingJob         TrainingJob[]
  ResourceUsageRecord ResourceUsageRecord[]
}

model TrainingRunAttempt {
  id                  String              @id @default(uuid())
  trainingRunId       String
  attemptNumber       Int                 @default(1)
  status              ModelTrainingStatus @default(QUEUED)
  executor            String
  startedAt           DateTime?
  completedAt         DateTime?
  resourceConsumption Json                @default("{}")
  failureReason       String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  trainingRun TrainingRun          @relation(fields: [trainingRunId], references: [id])
  checkpoints TrainingCheckpoint[]
  metrics     TrainingMetric[]
}

model TrainingCheckpoint {
  id               String   @id @default(uuid())
  attemptId        String
  checkpointNumber Int
  step             Int
  artifactRef      String
  metrics          Json     @default("{}")
  resourceUsage    Json     @default("{}")
  status           String   @default("COMPLETED")
  checksum         String?
  timestamp        DateTime @default(now())

  attempt TrainingRunAttempt @relation(fields: [attemptId], references: [id])
}

model TrainingMetric {
  id           String   @id @default(uuid())
  attemptId    String
  step         Int
  epoch        Float?
  name         String
  value        Float
  metricType   String
  checkpointId String?
  metadata     Json     @default("{}")
  timestamp    DateTime @default(now())

  attempt TrainingRunAttempt @relation(fields: [attemptId], references: [id])
}

enum ArtifactType {
  MODEL_WEIGHTS
  ADAPTER_WEIGHTS
  TOKENIZER
  CONFIGURATION
  EVALUATION_ARTIFACTS
  METADATA
}

model ModelArtifact {
  id             String       @id @default(uuid())
  type           ArtifactType
  checksum       String
  sizeBytes      Int
  storageRef     String
  creatorId      String
  trainingRunId  String?
  modelVersionId String?
  status         String       @default("REGISTERED") // REGISTERED, SIMULATED
  createdAt      DateTime     @default(now())

  companyId   String?
  Company     Company?     @relation(fields: [companyId], references: [id])
  trainingRun TrainingRun? @relation(fields: [trainingRunId], references: [id])
}

model ComputeWorker {
  id            String    @id @default(uuid())
  companyId     String?
  type          String
  capabilities  Json      @default("{}")
  status        String    @default("OFFLINE") // OFFLINE, IDLE, BUSY, ERROR, MAINTENANCE
  health        String    @default("UNKNOWN")
  version       String?
  lastHeartbeat DateTime?
  capacity      Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company      Company?             @relation(fields: [companyId], references: [id])
  reservations ComputeReservation[]
  jobs         TrainingJob[]
}

model ComputeReservation {
  id        String   @id @default(uuid())
  workerId  String
  jobId     String   @unique
  resources Json     @default("{}")
  status    String   @default("ACTIVE") // ACTIVE, RELEASED
  createdAt DateTime @default(now())

  worker ComputeWorker @relation(fields: [workerId], references: [id])
  job    TrainingJob   @relation(fields: [jobId], references: [id])
}

model TrainingJob {
  id                 String    @id @default(uuid())
  trainingRunId      String
  workerId           String?
  executor           String
  status             String    @default("QUEUED") // QUEUED, SCHEDULED, STARTING, RUNNING, COMPLETING, COMPLETED, FAILED, CANCELLED, TIMEOUT, RESOURCE_LIMIT, WORKER_LOST
  resourceAllocation Json      @default("{}")
  startedAt          DateTime?
  completedAt        DateTime?
  pid                Int?
  logsRef            String?
  checkpointLoc      String?
  artifactLoc        String?
  failureReason      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  trainingRun  TrainingRun            @relation(fields: [trainingRunId], references: [id])
  worker       ComputeWorker?         @relation(fields: [workerId], references: [id])
  reservation  ComputeReservation?
  heartbeats   TrainingJobHeartbeat[]
  logs         TrainingLog[]
  usageRecords ResourceUsageRecord[]
  Company      Company?               @relation(fields: [companyId], references: [id])
  companyId    String?
}

model TrainingJobHeartbeat {
  id            String   @id @default(uuid())
  jobId         String
  workerId      String
  progress      Float    @default(0.0)
  currentStep   Int      @default(0)
  resourceUsage Json     @default("{}")
  timestamp     DateTime @default(now())

  job TrainingJob @relation(fields: [jobId], references: [id])
}

model TrainingLog {
  id        String   @id @default(uuid())
  jobId     String
  severity  String   @default("INFO")
  message   String
  step      Int?
  category  String?
  timestamp DateTime @default(now())

  job TrainingJob @relation(fields: [jobId], references: [id])
}

model ResourceUsageRecord {
  id              String   @id @default(uuid())
  jobId           String
  runId           String
  computeUnits    Float    @default(0)
  cpuSeconds      Float    @default(0)
  gpuSeconds      Float    @default(0)
  memoryPeakMb    Float    @default(0)
  gpuMemoryPeakMb Float    @default(0)
  createdAt       DateTime @default(now())

  job TrainingJob @relation(fields: [jobId], references: [id])
  run TrainingRun @relation(fields: [runId], references: [id])
}

model ArtifactStorageLocation {
  id        String   @id @default(uuid())
  type      String
  uri       String
  companyId String?
  projectId String?
  createdAt DateTime @default(now())
}

model ModelFeedback {
  id             String  @id @default(uuid())
  taskId         String
  capabilityId   String? // Reference to ModelCapability if applicable
  modelFamilyId  String? // Reference to ModelFamily
  modelVersionId String?

  // Generalized I/O
  inputSnapshot   Json @default("{}")
  predictedOutput Json @default("{}")
  actualOutput    Json @default("{}")

  confidence Float?
  status     String @default("CANDIDATE") // CANDIDATE, VALIDATED, REJECTED

  companyId String?
  source    String  @default("USER") // USER, SYSTEM, EVALUATION

  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])
}

