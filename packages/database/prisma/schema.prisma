  SCHEDULED
  NOTIFIED
  RESCHEDULED
  IN_PROGRESS
  SUMMARIZING
  COMPLETED
  CANCELLED
}

enum MeetingKind {
  STANDARD
  BOARD
}

enum MeetingImportance {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MeetingLeader {
  CHAIRMAN
  ASSISTANT
}

model Meeting {
  id                  String               @id @default(uuid())
  companyId           String
  company             Company              @relation(fields: [companyId], references: [id])
  title               String
  description         String?
  organizerEmployeeId String?
  projectId           String?
  project             Project?             @relation(fields: [projectId], references: [id])
  departmentId        String?
  department          Department?          @relation(fields: [departmentId], references: [id])
  scheduledAt         DateTime
  durationMinutes     Int
  status              MeetingStatus        @default(SCHEDULED)
  createdAt           DateTime             @default(now())
  startedAt           DateTime?
  endedAt             DateTime?
  // Board meetings (Boardroom): who leads, what was said, and the Assistant's summary for the Chairman.
  kind                MeetingKind          @default(STANDARD)
  importance          MeetingImportance    @default(NORMAL)
  ledBy               MeetingLeader?
  notifiedAt          DateTime?
  rescheduleCount     Int                  @default(0)
  transcript          Json                 @default("[]") // [{speakerId, speakerName, text, at, agendaIndex}]
  currentAgendaIndex  Int                  @default(0)
  summary             String?
  summaryFilePath     String?
  summaryDeliveredAt  DateTime?
  summaryError        String?
  summaryBriefedAt    DateTime? // null + summary set = "brief me" still pending
  deckId              String?
  participants        MeetingParticipant[]
  agendaItems         MeetingAgendaItem[]
  notes               MeetingNote[]
  actionItems         MeetingActionItem[]

  @@index([companyId, kind, status])
}

enum MeetingAttendanceStatus {
  INVITED
  ACCEPTED
  DECLINED
  ATTENDED
  ABSENT
}

model MeetingParticipant {
  id               String                  @id @default(uuid())
  meetingId        String
  meeting          Meeting                 @relation(fields: [meetingId], references: [id])
  employeeId       String
  employee         Employee                @relation(fields: [employeeId], references: [id])
  attendanceStatus MeetingAttendanceStatus @default(INVITED)
  joinedAt         DateTime?
  leftAt           DateTime?

  @@unique([meetingId, employeeId])
}

enum MeetingAgendaItemStatus {
  PENDING
  DISCUSSION
  RESOLVED
  DEFERRED
}

model MeetingAgendaItem {
  id          String                  @id @default(uuid())
  meetingId   String
  meeting     Meeting                 @relation(fields: [meetingId], references: [id])
  title       String
  description String?
  order       Int                     @default(0)
  status      MeetingAgendaItemStatus @default(PENDING)
}

model MeetingNote {
  id               String   @id @default(uuid())
  meetingId        String
  meeting          Meeting  @relation(fields: [meetingId], references: [id])
  authorEmployeeId String?
  content          String
  createdAt        DateTime @default(now())
}

enum MeetingActionItemStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MeetingActionItem {
  id                 String                  @id @default(uuid())
  meetingId          String
  meeting            Meeting                 @relation(fields: [meetingId], references: [id])
  taskId             String?
  title              String
  description        String?
  assignedEmployeeId String?
  dueAt              DateTime?
  requiredCapability String?
  status             MeetingActionItemStatus @default(OPEN)
  createdAt          DateTime                @default(now())
  completedAt        DateTime?
}

enum NotificationPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

model Notification {
  id         String               @id @default(uuid())
  companyId  String
  company    Company              @relation(fields: [companyId], references: [id])
  employeeId String
  employee   Employee             @relation(fields: [employeeId], references: [id])
  type       String
  title      String
  body       String
  entityType String?
  entityId   String?
  priority   NotificationPriority @default(NORMAL)
  readAt     DateTime?
  createdAt  DateTime             @default(now())
}

model EmployeeRelationship {
  id                 String   @id @default(uuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  employeeAId        String
  employeeBId        String
  employeeA          Employee @relation("RelationshipA", fields: [employeeAId], references: [id])
  employeeB          Employee @relation("RelationshipB", fields: [employeeBId], references: [id])
  collaborationCount Int      @default(0)
  meetingsTogether   Int      @default(0)
  messagesExchanged  Int      @default(0)
  mentorshipScore    Int?
  professionalTrust  Int?
  updatedAt          DateTime @updatedAt

  @@unique([companyId, employeeAId, employeeBId])
}

// ------------------------------------------------------
// PHASE 11: COMPANY KNOWLEDGE & INSTITUTIONAL MEMORY
// ------------------------------------------------------

enum KnowledgeType {
  POLICY
  DECISION
  PROJECT_KNOWLEDGE
  TECHNICAL_KNOWLEDGE
  CLIENT_REQUIREMENT
  PROCESS
  LESSON_LEARNED
  FACT
  ARCHITECTURE_DECISION
  EXPERIMENT_RESULT
  BUSINESS_KNOWLEDGE
  ORGANIZATIONAL_KNOWLEDGE
  RISK_KNOWLEDGE
  OTHER
}

enum KnowledgeStatus {
  CANDIDATE
  VALIDATED
  CANONICAL
  SUPERSEDED
  REJECTED
  ARCHIVED
}

enum KnowledgeImportance {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model KnowledgeRecord {
  id                   String                @id @default(uuid())
  companyId            String
  company              Company               @relation(fields: [companyId], references: [id])
  type                 KnowledgeType
  title                String
  content              String
  summary              String?
  status               KnowledgeStatus       @default(CANDIDATE)
  confidence           Int                   @default(50) // 0-100
  importance           KnowledgeImportance   @default(NORMAL)
  validFrom            DateTime              @default(now())
  validUntil           DateTime?
  createdByEmployeeId  String?
  createdByUser        Employee?             @relation("CreatedKnowledge", fields: [createdByEmployeeId], references: [id])
  approvedByEmployeeId String?
  approvedByUser       Employee?             @relation("ApprovedKnowledge", fields: [approvedByEmployeeId], references: [id])
  projectId            String?
  project              Project?              @relation(fields: [projectId], references: [id])
  departmentId         String?
  department           Department?           @relation(fields: [departmentId], references: [id])
  supersedesId         String?               @unique
  supersedes           KnowledgeRecord?      @relation("SupersessionChain", fields: [supersedesId], references: [id])
  supersededBy         KnowledgeRecord?      @relation("SupersessionChain")
  metadata             Json?                 @default("{}")
  sources              KnowledgeSource[]
  validations          KnowledgeValidation[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

enum KnowledgeSourceType {
  MESSAGE
  MEETING
  MEETING_NOTE
  MEETING_ACTION
  TASK
  PROJECT
  PROJECT_REQUIREMENT
  PROJECT_DELIVERY
  TASK_REVIEW
  DECISION
  POLICY
  SIMULATION_EVENT
  EXPERIMENT
  MANUAL_ENTRY
}

model KnowledgeSource {
  id               String              @id @default(uuid())
  knowledgeId      String
  knowledge        KnowledgeRecord     @relation(fields: [knowledgeId], references: [id])
  sourceType       KnowledgeSourceType
  sourceId         String
  sourceReference  String?
  excerptOrSummary String?
  createdAt        DateTime            @default(now())
}

enum KnowledgeValidationType {
  MANUAL
  SOURCE_CORROBORATION
  PROJECT_RESULT
  MANAGER_REVIEW
  CHAIRMAN_APPROVAL
  SYSTEM_VALIDATION
}

enum KnowledgeValidationResult {
  SUPPORTED
  UNSUPPORTED
  CONFLICTING
}

model KnowledgeValidation {
  id                  String                    @id @default(uuid())
  knowledgeId         String
  knowledge           KnowledgeRecord           @relation(fields: [knowledgeId], references: [id])
  validatorEmployeeId String?
  validatorEmployee   Employee?                 @relation(fields: [validatorEmployeeId], references: [id])
  validationType      KnowledgeValidationType
  result              KnowledgeValidationResult
  reason              String?
  createdAt           DateTime                  @default(now())
}

// --- Phase 12: Employee Intelligence Actions ---

model IntelligenceSession {
  id         String   @id @default(uuid())
  companyId  String
  employeeId String
  objective  String
  status     String   @default("ACTIVE") // ACTIVE, COMPLETED, FAILED
  taskId     String?
  projectId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  task     Task?    @relation(fields: [taskId], references: [id])
  project  Project? @relation(fields: [projectId], references: [id])

  assessments IntelligenceAssessment[]
  plans       IntelligencePlan[]
  proposals   DecisionProposal[]
  risks       RiskObservation[]
  outcomes    IntelligenceOutcome[]
}

model IntelligenceAssessment {
  id             String   @id @default(uuid())
  sessionId      String
  summary        String
  recommendation String
  risks          Json?
  uncertainties  Json?
  assumptions    Json?
  options        Json?
  createdAt      DateTime @default(now())

  session  IntelligenceSession    @relation(fields: [sessionId], references: [id])
  evidence IntelligenceEvidence[]
}

model IntelligenceEvidence {
  id           String   @id @default(uuid())
  assessmentId String
  sourceType   String
  sourceId     String
  summary      String
  createdAt    DateTime @default(now())

  assessment IntelligenceAssessment @relation(fields: [assessmentId], references: [id])
}

model IntelligencePlan {
  id        String   @id @default(uuid())
  sessionId String
  objective String
  status    String   @default("PENDING") // DRAFT, APPROVED, PENDING, IN_PROGRESS, COMPLETED
  createdAt DateTime @default(now())

  session IntelligenceSession    @relation(fields: [sessionId], references: [id])
  steps   IntelligencePlanStep[]
}

model IntelligencePlanStep {
  id          String   @id @default(uuid())
  planId      String
  sequence    Int      @default(0)
  title       String
  description String?
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, BLOCKED
  createdAt   DateTime @default(now())

  plan IntelligencePlan @relation(fields: [planId], references: [id])
}

model DecisionProposal {
  id             String   @id @default(uuid())
  companyId      String
  employeeId     String
  sessionId      String?
  status         String   @default("PROPOSED") // PROPOSED, APPROVED, REJECTED, REQUEST_MORE_INFORMATION, IMPLEMENTED
  title          String
  problem        String
  recommendation String
  rationale      String
  confidence     String   @default("MEDIUM")
  impactLevel    String   @default("MEDIUM")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company  Company              @relation(fields: [companyId], references: [id])
  employee Employee             @relation("DecisionProposer", fields: [employeeId], references: [id])
  session  IntelligenceSession? @relation(fields: [sessionId], references: [id])

  options DecisionOption[]
  reviews DecisionReview[]
}

model DecisionOption {
  id              String  @id @default(uuid())
  proposalId      String
  title           String
  description     String
  advantages      Json    @default("[]")
  disadvantages   Json    @default("[]")
  risks           Json    @default("[]")
  estimatedEffort String?
  estimatedImpact String?
  score           Int?

  proposal DecisionProposal @relation(fields: [proposalId], references: [id])
}

model DecisionReview {
  id         String   @id @default(uuid())
  proposalId String
  reviewerId String
  result     String // APPROVE, REJECT, REQUEST_MORE_INFORMATION
  feedback   String?
  createdAt  DateTime @default(now())

  proposal DecisionProposal @relation(fields: [proposalId], references: [id])
  reviewer Employee         @relation("DecisionReviewer", fields: [reviewerId], references: [id])
}

model AssistanceRequest {
  id               String   @id @default(uuid())
  companyId        String
  requesterId      String
  targetEmployeeId String?
  taskId           String?
  projectId        String?
  question         String
  reason           String?
  urgency          String   @default("MEDIUM")
  status           String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  createdAt        DateTime @default(now())

  company        Company   @relation(fields: [companyId], references: [id])
  requester      Employee  @relation("AssistanceRequester", fields: [requesterId], references: [id])
  targetEmployee Employee? @relation("AssistanceTarget", fields: [targetEmployeeId], references: [id])
  task           Task?     @relation(fields: [taskId], references: [id])
  project        Project?  @relation(fields: [projectId], references: [id])
}

model RiskObservation {
  id          String   @id @default(uuid())
  sessionId   String
  category    String
  description String
  severity    String
  likelihood  String
  evidence    String?
  mitigation  String?
  status      String   @default("IDENTIFIED") // IDENTIFIED, MITIGATED, ACCEPTED, REALIZED
  createdAt   DateTime @default(now())

  session IntelligenceSession @relation(fields: [sessionId], references: [id])
}

model IntelligenceOutcome {
  id              String   @id @default(uuid())
  sessionId       String
  result          String
  actualOutcome   String
  expectedOutcome String
  success         Boolean  @default(true)
  lessons         String?
  createdAt       DateTime @default(now())

  session IntelligenceSession @relation(fields: [sessionId], references: [id])
}

// ------------------------------------------------------
// PHASE 13: AI RESEARCH & DEVELOPMENT LABORATORY
// ------------------------------------------------------

enum ResearchProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

model ResearchProposal {
  id               String                 @id @default(uuid())
  companyId        String
  title            String
  description      String
  researchQuestion String
  hypothesis       String
  objectives       String
  requestedBudget  Int                    @default(0) // Simulated AC or Real Money allocation
  requestedCompute Int                    @default(0) // Abstract compute units
  riskLevel        String                 @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  status           ResearchProposalStatus @default(DRAFT)
  proposerId       String
  reviewerId       String?
  approvalMetadata Json                   @default("{}")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  company  Company           @relation(fields: [companyId], references: [id])
  proposer Employee          @relation("ProposalProposer", fields: [proposerId], references: [id])
  reviewer Employee?         @relation("ProposalReviewer", fields: [reviewerId], references: [id])
  projects ResearchProject[]
}

enum ResearchProjectStatus {
  PLANNED
  ACTIVE
  EXECUTING
  SYNTHESIZING
  OUTCOME_READY
  CEO_REVIEW
  CHAIRMAN_REVIEW
  REVISION_REQUIRED
  APPROVED
  REJECTED
  PAUSED
  COMPLETED
  CANCELLED
}

model ResearchProject {
  id             String                @id @default(uuid())
  companyId      String
  proposalId     String
  name           String
  description    String
  objectives     String
  ownerId        String
  budget         Int                   @default(0)
  resourceLimits Json                  @default("{}")
  status         ResearchProjectStatus @default(PLANNED)
  startDate      DateTime?
  endDate        DateTime?
  metadata       Json                  @default("{}")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  company               Company                 @relation(fields: [companyId], references: [id])
  proposal              ResearchProposal        @relation(fields: [proposalId], references: [id])
  owner                 Employee                @relation("ProjectOwner", fields: [ownerId], references: [id])
  experiments           Experiment[]
  TrainingConfiguration TrainingConfiguration[]
  perspectives          ResearchPerspective[]
  syntheses             ResearchSynthesis[]
  executions            ResearchExecution[]
}

enum ResearchExecutionState {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  RETRYING
  CANCELLED
}

model ResearchExecution {
  id           String                 @id @default(uuid())
  projectId    String
  employeeId   String
  state        ResearchExecutionState @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  errorDetails Json?
  metadata     Json                   @default("{}")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  project  ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id])

  sources      ResearchSource[]
  findings     ResearchFinding[]
  perspectives ResearchPerspective[]
}

model ResearchSource {
  id            String   @id @default(uuid())
  executionId   String
  url           String?
  title         String?
  publisher     String?
  sourceType    String   @default("WEB")
  retrievalTime DateTime @default(now())
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  execution ResearchExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  findings  ResearchFinding[]
}

model ResearchFinding {
  id          String   @id @default(uuid())
  executionId String
  sourceId    String?
  content     String   @db.Text
  relevance   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  execution ResearchExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  source    ResearchSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
}

model ResearchPerspective {
  id          String   @id @default(uuid())
  projectId   String
  executionId String?
  employeeId  String
  roleContext String
  findings    String
  confidence  Float    @default(0)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   ResearchProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  execution ResearchExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)
  employee  Employee           @relation(fields: [employeeId], references: [id])
}

model ResearchSynthesis {
  id                  String   @id @default(uuid())
  projectId           String
  synthesizerId       String?
  executiveSummary    String
  comprehensiveReport String
  actionableInsights  Json     @default("[]")
  status              String   @default("DRAFT")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  synthesizer Employee?       @relation(fields: [synthesizerId], references: [id])
}

enum ExperimentStatus {
  PLANNED
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
  RESOURCE_LIMIT
}

model Experiment {
  id                  String           @id @default(uuid())
  researchProjectId   String
  experimentNumber    Int              @default(1)
  name                String
  hypothesis          String
  configuration       Json             @default("{}")
  modelVersionId      String?
  hyperparameters     Json             @default("{}")
  resourceAllocation  Json             @default("{}")
  randomSeed          String?
  codeIdentifier      String?
  status              ExperimentStatus @default(PLANNED)
  parentExperimentId  String?
  reproducibilityData Json             @default("{}")
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  project          ResearchProject  @relation(fields: [researchProjectId], references: [id])
  modelVersion     ModelVersion?    @relation("ExperimentModel", fields: [modelVersionId], references: [id])
  parentExperiment Experiment?      @relation("ExperimentHierarchy", fields: [parentExperimentId], references: [id])
  childExperiments Experiment[]     @relation("ExperimentHierarchy")
  datasetVersions  DatasetVersion[] @relation("ExperimentDatasets")
  evaluations      EvaluationRun[]
}

enum DatasetStatus {
  DRAFT
  VALIDATING
  READY
  DEPRECATED
  ARCHIVED
}

model Dataset {
  id              String        @id @default(uuid())
  name            String
  description     String
  type            String // e.g. TEXT, IMAGE, MULTIMODAL, TABULAR
  owner           String // Freeform or actor ID
  provenance      String
  licenseMetadata Json          @default("{}")
  source          String
  status          DatasetStatus @default(DRAFT)
  sensitivity     String        @default("PUBLIC") // PUBLIC, INTERNAL, CONFIDENTIAL, RESTRICTED
  createdBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  companyId String?
  Company   Company?         @relation(fields: [companyId], references: [id])
  versions  DatasetVersion[]
}

model DatasetVersion {
  id              String   @id @default(uuid())
  datasetId       String
  version         String
  contentHash     String
  sizeBytes       Int
  lineage         Json     @default("[]")
  creationProcess String
  sourceVersions  Json     @default("[]")
  transformations Json     @default("[]")
  validationState String   @default("PENDING") // PENDING, VALIDATED, FAILED
  trainPath       String?
  valPath         String?
  testPath        String?
  createdAt       DateTime @default(now())

  dataset        Dataset          @relation(fields: [datasetId], references: [id])
  experiments    Experiment[]     @relation("ExperimentDatasets")
  Company        Company?         @relation(fields: [companyId], references: [id])
  companyId      String?
  ExperimentPlan ExperimentPlan[]
}

model ModelCapability {
  id                  String   @id @default(uuid())
  companyId           String
  name                String
  description         String?
  taskType            String
  inputSchema         Json     @default("{}")
  outputSchema        Json     @default("{}")
  activeVersionId     String?
  confidenceThreshold Float    @default(0.7)
  latencyTarget       Int      @default(200) // ms
  status              String   @default("ACTIVE") // ACTIVE, DEPRECATED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  models  ModelFamily[]
  company Company       @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

model ModelFamily {
  id          String   @id @default(uuid())
  name        String
  description String
  provider    String   @default("AEVORA_INTERNAL") // Provider name
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  capabilityId String?
  capability   ModelCapability? @relation(fields: [capabilityId], references: [id])

  versions           ModelVersion[]
  researchHypotheses ResearchHypothesis[]
  Company            Company?             @relation(fields: [companyId], references: [id])
  companyId          String?
}

enum ModelVersionStatus {
  EXPERIMENTAL
  EVALUATING
  SAFETY_REVIEW
  APPROVED_FOR_LIMITED_DEPLOYMENT
  LIMITED_DEPLOYMENT
  PRODUCTION
  ROLLED_BACK
  RETIRED
  REJECTED
}

model ModelVersion {
  id               String             @id @default(uuid())
  modelId          String
  version          String
  artifactRef      String
  baseModelId      String?
  parentModelId    String?
  trainingExpId    String?
  metadata         Json               @default("{}")
  benchmarkResults Json               @default("{}")
  safetyResults    Json               @default("{}")
  status           ModelVersionStatus @default(EXPERIMENTAL)
  deploymentState  Json               @default("{}")
  createdBy        String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  modelFamily    ModelFamily    @relation(fields: [modelId], references: [id])
  baseModel      ModelVersion?  @relation("ModelLineageBase", fields: [baseModelId], references: [id])
  derivedModelsB ModelVersion[] @relation("ModelLineageBase")
  parentModel    ModelVersion?  @relation("ModelLineageParent", fields: [parentModelId], references: [id])
  derivedModelsP ModelVersion[] @relation("ModelLineageParent")

  // Note: trainingExpId logic is handled logically or via the reverse relation from Experiment
  experiments         Experiment[]        @relation("ExperimentModel")
  evaluations         EvaluationRun[]
  safetyEvals         SafetyEvaluation[]
  deployments         LimitedDeployment[]
  rollbackDeployments LimitedDeployment[] @relation("RollbackTarget")

  improvementSignals   ImprovementSignal[]
  baselineExperiments  ExperimentPlan[]    @relation("ExperimentBaseline")
  candidateExperiments ExperimentPlan[]    @relation("ExperimentCandidate")
  Company              Company?            @relation(fields: [companyId], references: [id])
  companyId            String?
}

model BenchmarkSuite {
  id          String   @id @default(uuid())
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId  String?
  Company    Company?    @relation(fields: [companyId], references: [id])
  benchmarks Benchmark[]
}

model Benchmark {
  id                 String   @id @default(uuid())
  suiteId            String
  name               String
  description        String
  evaluationCriteria String
  version            String
  datasetRef         String?
  scoringMethod      String
  baselineVersionId  String? // Track explicitly selected baseline model for this benchmark
  createdAt          DateTime @default(now())

  suite       BenchmarkSuite  @relation(fields: [suiteId], references: [id])
  evaluations EvaluationRun[]
}

enum EvaluationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model EvaluationRun {
  id              String           @id @default(uuid())
  modelVersionId  String
  benchmarkId     String
  experimentId    String?
  evaluator       String
  score           Float?
  metrics         Json             @default("{}")
  configuration   Json             @default("{}")
  status          EvaluationStatus @default(QUEUED)
  reproducibility Json             @default("{}")
  createdAt       DateTime         @default(now())
  completedAt     DateTime?

  modelVersion ModelVersion @relation(fields: [modelVersionId], references: [id])
  benchmark    Benchmark    @relation(fields: [benchmarkId], references: [id])
  experiment   Experiment?  @relation(fields: [experimentId], references: [id])
}

model InferenceLog {
  id             String   @id @default(uuid())
  deploymentId   String?
  modelVersionId String?
  capabilityId   String?
  companyId      String
  latencyMs      Int
  success        Boolean
