enum CeoFinancialAuthorityStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum CeoFinancialOperation {
  VIEW_FINANCIALS
  CREATE_BUDGET
  MODIFY_BUDGET
  CREATE_RESERVATION
  APPROVE_RESERVATION
  AUTHORIZE_EXPENSE
  AUTHORIZE_PAYMENT
  EXECUTE_PAYMENT
  REFUND
  TRANSFER_FUNDS
  WITHDRAW_FUNDS
}

model CeoFinancialAuthority {
  id                            String                      @id @default(uuid())
  companyId                     String
  company                       Company                     @relation(fields: [companyId], references: [id])
  ceoEmployeeId                 String
  ceoEmployee                   Employee                    @relation(fields: [ceoEmployeeId], references: [id])
  authorityStatus               CeoFinancialAuthorityStatus @default(ACTIVE)
  singleTransactionLimit        Int                         @default(0) // in smallest currency unit
  dailyLimit                    Int                         @default(0)
  monthlyLimit                  Int                         @default(0)
  budgetLimit                   Boolean                     @default(true)
  allowedOperations             CeoFinancialOperation[]
  requiresChairmanApprovalAbove Int? // Optional threshold before strict rejection
  effectiveFrom                 DateTime                    @default(now())
  effectiveUntil                DateTime?
  grantedBy                     String? // Chairman ID or system
  revokedBy                     String?
  reason                        String?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt

  decisions CeoFinancialDecision[]

  @@index([companyId, authorityStatus])
}

model CeoFinancialDecision {
  id                  String                 @id @default(uuid())
  companyId           String
  company             Company                @relation(fields: [companyId], references: [id])
  ceoEmployeeId       String
  ceoEmployee         Employee               @relation(fields: [ceoEmployeeId], references: [id])
  operation           CeoFinancialOperation
  amount              Int                    @default(0)
  currency            String                 @default("INR")
  budgetId            String?
  authorityId         String?
  authority           CeoFinancialAuthority? @relation(fields: [authorityId], references: [id])
  decision            String // AUTHORIZED, REJECTED, REQUIRES_APPROVAL
  reason              String?
  chairmanApprovalRef String? // Reference to ChairmanCommand or similar
  idempotencyKey      String                 @unique
  paymentRef          String?
  createdAt           DateTime               @default(now())

  @@index([companyId, operation, createdAt])
}

enum StrategicMilestoneStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  BLOCKED
}

model StrategicMilestone {
  id             String                   @id @default(uuid())
  companyId      String
  company        Company                  @relation(fields: [companyId], references: [id])
  objectiveId    String
  objective      CompanyObjective         @relation(fields: [objectiveId], references: [id])
  name           String
  dueDate        DateTime
  status         StrategicMilestoneStatus @default(UPCOMING)
  completionDate DateTime?
  ownerId        String
  owner          Employee                 @relation(fields: [ownerId], references: [id])
  dependencies   Json                     @default("[]")
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([companyId, status])
  @@index([objectiveId])
}

enum PerformanceStatus {
  EXCEPTIONAL
  STRONG
  STABLE
  AT_RISK
  UNDERPERFORMING
  CRITICAL
  INSUFFICIENT_DATA
}

enum EvaluationWorkflowStatus {
  DRAFT
  READY_FOR_REVIEW
  REVIEWED
  ACKNOWLEDGED
  ACTION_REQUIRED
  CLOSED
}

enum SuccessionRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SuccessionStatus {
  HEALTHY
  MONITORING
  AT_RISK
  CRITICAL_VACANCY
}

enum CandidateReadiness {
  NOT_READY
  DEVELOPING
  READY_SOON
  READY
  NOT_ELIGIBLE
  REJECTED
}

model PerformanceEvaluation {
  id           String      @id @default(uuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], name: "CompanyEvals")
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id], name: "EmployeeEvals")
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  evaluatorId  String
  evaluator    Employee    @relation("Evaluator", fields: [evaluatorId], references: [id])

  periodStart    DateTime
  periodEnd      DateTime
  workflowStatus EvaluationWorkflowStatus @default(DRAFT)
  status         PerformanceStatus        @default(INSUFFICIENT_DATA)

  overallScore     Int?
  kpiScore         Int?
  taskScore        Int?
  projectScore     Int?
  operationalScore Int?

  strengths       Json?
  weaknesses      Json?
  risks           Json?
  recommendations Json?

  underlyingData       Json?
  isDepartmentLeadEval Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SuccessionPlan {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], name: "CompanySuccessionPlans")

  roleId       String
  role         Role        @relation(fields: [roleId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  currentHolderId String?
  currentHolder   Employee?           @relation("CurrentHolder", fields: [currentHolderId], references: [id])
  status          SuccessionStatus    @default(HEALTHY)
  riskLevel       SuccessionRiskLevel @default(LOW)

  transitionPlan String?
  nextReviewDate DateTime?

  candidates SuccessionCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, roleId, departmentId])
}

model SuccessionCandidate {
  id         String         @id @default(uuid())
  planId     String
  plan       SuccessionPlan @relation(fields: [planId], references: [id])
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], name: "EmployeeSuccessionCands")

  readiness         CandidateReadiness @default(NOT_READY)
  eligibilityReason String?

  developmentGaps      Json?
  developmentActions   Json?
  riskFlags            Json?
  leadershipIndicators Json?
  underlyingData       Json?

  recommendationStatus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, employeeId])
}

// ─── OODA Operating Loop ───────────────────────────────────────────────────

enum OodaPhase {
  OBSERVE
  THINK
  DECIDE
  ASK_CHAIRMAN
  EXECUTE
  MEASURE
  LEARN
  COMPLETE
  FAILED
}

model OperatingLoopCycle {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  phase           OodaPhase @default(OBSERVE)
  trigger         String
  observations    Json      @default("{}") // signals collected in OBSERVE
  analysis        Json      @default("{}") // reasoning from THINK
  options         Json      @default("[]") // generated in DECIDE
  recommendation  Json? // best option picked
  chairmanVerdict String? // APPROVED / REJECTED / null
  execution       Json      @default("{}") // what happened in EXECUTE
  measurements    Json      @default("{}") // KPIs/outcomes from MEASURE
  lessons         Json      @default("[]") // stored in LEARN
  error           String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, phase])
  @@index([companyId, createdAt(sort: Desc)])
}

enum ClientMeetingStatus {
  REQUESTED
  WAITING_FOR_OWNER_TIME
  WAITING_FOR_CLIENT_CONFIRMATION
  CLIENT_PROPOSED_ALTERNATIVE
  WAITING_FOR_OWNER_CONFIRMATION
  CONFIRMED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  NOT_RECORDED
  RECORDED
  NOTES_READY
  ADDED_TO_PROJECT
  CANCELLED
}

model ClientMeeting {
  id              String              @id @default(uuid())
  companyId       String
  leadId          String?
  clientId        String?
  projectId       String?
  opportunityId   String?
  threadId        String?
  timezone        String?
  proposedTimes   Json // Array of ISO strings
  confirmedTime   DateTime?
  status          ClientMeetingStatus @default(REQUESTED)
  link            String?
  recordingUrl    String?
  transcript      String?
  extractedNotes  Json?
  notesApprovedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  lead        SalesLead?   @relation(fields: [leadId], references: [id])
  client      Client?      @relation(fields: [clientId], references: [id])
  project     Project?     @relation(fields: [projectId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
}

enum ProjectExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ProjectTestStatus {
  RUNNING
  PASSED
  FAILED
}

model ProjectDevelopmentExecution {
  id            String                 @id @default(uuid())
  projectId     String
  employeeId    String?
  taskId        String?
  status        ProjectExecutionStatus @default(RUNNING)
  startedAt     DateTime               @default(now())
  completedAt   DateTime?
  sourcePath    String?
  logs          String?
  failureReason String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @default(now()) @updatedAt

  project Project @relation(fields: [projectId], references: [id])
}

model ProjectBuildExecution {
  id            String                 @id @default(uuid())
  projectId     String
  status        ProjectExecutionStatus @default(RUNNING)
  startedAt     DateTime               @default(now())
  completedAt   DateTime?
  logs          String?
  artifactPath  String?
  version       String?
  failureReason String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @default(now()) @updatedAt

  project Project @relation(fields: [projectId], references: [id])
}

model ProjectTestExecution {
  id            String            @id @default(uuid())
  projectId     String
  buildId       String
  testCommand   String?
  status        ProjectTestStatus @default(RUNNING)
  startedAt     DateTime          @default(now())
  completedAt   DateTime?
  logs          String?
  failureReason String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt

  project Project @relation(fields: [projectId], references: [id])
}

model TaskResult {
  id        String   @id @default(uuid())
  taskId    String   @unique
  task      Task     @relation(fields: [taskId], references: [id])
  workerId  String
  worker    Employee @relation("WorkerTaskResults", fields: [workerId], references: [id])
  success   Boolean
  summary   String
  output    Json     @default("{}")
  errors    Json     @default("[]")
  createdAt DateTime @default(now())
}
