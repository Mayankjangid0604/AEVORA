  ownerId               String
  registeredBy          String
  approvedBy            String?
  approvedAt            DateTime?
  strategicThemeId      String?
  strategicInitiativeId String?
  researchProjectId     String?
  labProjectId          String?
  currentVersion        String?
  isAdvisory            Boolean                @default(true)
  isArchived            Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  versions              PfProductVersion[]
  ideas                 PfProductIdea[]
  features              PfProductFeature[]
  releases              PfProductRelease[]
  launches              PfProductLaunch[]
