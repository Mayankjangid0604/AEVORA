  company      Company            @relation("MpProviderCompany", fields: [companyId], references: [id])
  models       MpModel[]
  health       MpProviderHealth[]
  killSwitches MpKillSwitch[]     @relation("KillSwitchProvider")

  @@unique([companyId, providerType, displayName])
}

model MpProviderHealth {
  id            String    @id @default(uuid())
  companyId     String
  providerId    String
  status        String    @default("UNKNOWN")
  p50LatencyMs  Int?
  p95LatencyMs  Int?
