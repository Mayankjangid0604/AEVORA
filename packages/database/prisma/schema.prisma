model PfProductAuditEvent {
  id         String     @id @default(uuid())
  companyId  String
  company    Company    @relation("PfAuditCompany", fields: [companyId], references: [id])
  actorId    String
  productId  String?
  product    PfProduct? @relation(fields: [productId], references: [id])
  action     String
  objectType String?
  objectId   String?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime   @default(now())

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, productId])
}

// ─── Phase 35: Autonomous Business Units ─────────────────────────────────────

enum BuStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  RESTRUCTURING
  SUSPENDED
  RETIRED
}

enum BuLifecycle {
  CHARTER
  STRATEGY
  OBJECTIVES
  WORKFORCE
  OPERATIONS
  PERFORMANCE
  REVIEW
  RETIRED
}

enum BuCapitalRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum BuKpiStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  NOT_STARTED
}

enum BuRiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model BusinessUnit {
  id               String         @id @default(uuid())
  companyId        String
  company          Company        @relation("BuCompany", fields: [companyId], references: [id])
  name             String
  code             String
  description      String?
  charter          String?
  status           BuStatus       @default(DRAFT)
  lifecycle        BuLifecycle    @default(CHARTER)
  leaderId         String?
  parentBuId       String?
  parentBu         BusinessUnit?  @relation("BuParent", fields: [parentBuId], references: [id])
  childBus         BusinessUnit[] @relation("BuParent")
  strategicThemeId String?
  registeredBy     String
  approvedBy       String?
  approvedAt       DateTime?
  retiredAt        DateTime?
  retiredBy        String?
  isAdvisory       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  objectives         BuObjective[]
  kpis               BuKpi[]
  budgets            BuBudget[]
  risks              BuRisk[]
  capitalRequests    BuCapitalRequest[]
  performanceReviews BuPerformanceReview[]
  auditEvents        BuAuditEvent[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

model BuObjective {
  id          String       @id @default(uuid())
  companyId   String
  buId        String
  bu          BusinessUnit @relation(fields: [buId], references: [id])
  title       String
  description String?
  targetValue String?
  dueDate     DateTime?
  status      String       @default("ACTIVE")
  isAdvisory  Boolean      @default(true)
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([companyId, buId])
}

model BuKpi {
  id           String       @id @default(uuid())
  companyId    String
  buId         String
  bu           BusinessUnit @relation(fields: [buId], references: [id])
  name         String
  description  String?
  currentValue String?
  targetValue  String?
  unit         String?
  status       BuKpiStatus  @default(NOT_STARTED)
  isAdvisory   Boolean      @default(true)
  recordedBy   String
  periodStart  DateTime?
  periodEnd    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([companyId, buId])
}

model BuBudget {
  id                String       @id @default(uuid())
  companyId         String
  buId              String
  bu                BusinessUnit @relation(fields: [buId], references: [id])
  fiscalYear        Int
  fiscalQuarter     Int?
  allocatedMc       Int
  forecastedSpendMc Int?
  actualSpendMc     Int?
  notes             String?
  isAdvisory        Boolean      @default(true)
  createdBy         String
  approvedBy        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([companyId, buId, fiscalYear, fiscalQuarter])
  @@index([companyId, buId])
}

model BuRisk {
  id          String         @id @default(uuid())
  companyId   String
  buId        String
  bu          BusinessUnit   @relation(fields: [buId], references: [id])
  title       String
  description String?
  severity    BuRiskSeverity @default(MEDIUM)
  likelihood  String?
  mitigation  String?
  status      String         @default("OPEN")
  isAdvisory  Boolean        @default(true)
  raisedBy    String
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([companyId, buId])
}

model BuCapitalRequest {
  id              String                 @id @default(uuid())
  companyId       String
  buId            String
  bu              BusinessUnit           @relation(fields: [buId], references: [id])
  title           String
  description     String?
  amountMc        Int
  currency        String                 @default("USD")
  justification   String?
  expectedReturn  String?
  status          BuCapitalRequestStatus @default(DRAFT)
  requestedBy     String
  reviewedBy      String?
  approvedBy      String?
  rejectedBy      String?
  rejectionReason String?
  approvedAt      DateTime?
  idempotencyKey  String                 @unique
  isAdvisory      Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([companyId, buId, status])
}

model BuPerformanceReview {
  id          String       @id @default(uuid())
  companyId   String
  buId        String
  bu          BusinessUnit @relation(fields: [buId], references: [id])
  period      String
  summary     String?
  kpiScorePct Int?
  reviewedBy  String
  approvedBy  String?
  isAdvisory  Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([companyId, buId, period])
  @@index([companyId, buId])
}

model BuAuditEvent {
  id         String        @id @default(uuid())
  companyId  String
  buId       String?
  bu         BusinessUnit? @relation(fields: [buId], references: [id])
  actorId    String
  action     String
  objectType String?
  objectId   String?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime      @default(now())

  @@index([companyId, buId])
  @@index([companyId, createdAt])
}

// ─── Phase 36: Autonomous Capital Allocation ──────────────────────────────────

enum CaAllocationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  EXECUTING
  COMPLETE
  CANCELLED
}

enum CaProposalStatus {
  DRAFT
  SUBMITTED
  ANALYZING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CaScenarioType {
  BASE
  OPTIMISTIC
  PESSIMISTIC
  STRESS
}

enum CaInvestmentCategory {
  PRODUCT
  RESEARCH
  INFRASTRUCTURE
  WORKFORCE
  MARKETING
  ACQUISITION
  OTHER
}

enum CaRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model CaCapitalPool {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation("CaCompany", fields: [companyId], references: [id])
  name        String
  description String?
  totalMc     Int
  availableMc Int
  committedMc Int      @default(0)
  currency    String   @default("USD")
  fiscalYear  Int
  isAdvisory  Boolean  @default(true)
  createdBy   String
  approvedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proposals   CaAllocationProposal[]
  constraints CaConstraint[]
  auditEvents CaAuditEvent[]

  @@unique([companyId, name, fiscalYear])
  @@index([companyId, fiscalYear])
}

model CaAllocationProposal {
  id               String               @id @default(uuid())
  companyId        String
  poolId           String
  pool             CaCapitalPool        @relation(fields: [poolId], references: [id])
  title            String
  description      String?
  category         CaInvestmentCategory @default(OTHER)
  targetBuId       String?
  targetProductId  String?
  targetStrategyId String?
  requestedMc      Int
  currency         String               @default("USD")
  justification    String?
  expectedRoiPct   Int?
  riskLevel        CaRiskLevel          @default(MEDIUM)
  status           CaProposalStatus     @default(DRAFT)
  proposedBy       String
  reviewedBy       String?
  approvedBy       String?
  rejectedBy       String?
  rejectionReason  String?
  approvedAt       DateTime?
  idempotencyKey   String               @unique
  isAdvisory       Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  scenarios   CaScenario[]
  allocations CaAuthorizedAllocation[]

  @@index([companyId, poolId, status])
}

model CaScenario {
  id                String               @id @default(uuid())
  companyId         String
  proposalId        String
  proposal          CaAllocationProposal @relation(fields: [proposalId], references: [id])
  scenarioType      CaScenarioType       @default(BASE)
  label             String?
  projectedReturnMc Int?
  projectedRoiPct   Int?
  timeHorizonMonths Int?
  assumptions       String?
  isAdvisory        Boolean              @default(true)
  createdBy         String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([companyId, proposalId])
}

model CaConstraint {
  id               String        @id @default(uuid())
  companyId        String
  poolId           String
  pool             CaCapitalPool @relation(fields: [poolId], references: [id])
  name             String
  description      String?
  maxSingleAllocMc Int?
  minLiquidityMc   Int?
  maxCategoryPct   Int?
  maxBuPct         Int?
  isAdvisory       Boolean       @default(true)
  createdBy        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([companyId, poolId])
}

model CaAuthorizedAllocation {
  id             String               @id @default(uuid())
  companyId      String
  proposalId     String
  proposal       CaAllocationProposal @relation(fields: [proposalId], references: [id])
  amountMc       Int
  currency       String               @default("USD")
  status         CaAllocationStatus   @default(APPROVED)
  authorizedBy   String
  authorizedAt   DateTime             @default(now())
  executedBy     String?
  executedAt     DateTime?
  completedAt    DateTime?
  notes          String?
  idempotencyKey String               @unique
  isAdvisory     Boolean              @default(false)
  financeRef     String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  performance CaAllocationPerformance[]

  @@index([companyId, proposalId, status])
}

model CaAllocationPerformance {
  id               String                 @id @default(uuid())
  companyId        String
  allocationId     String
  allocation       CaAuthorizedAllocation @relation(fields: [allocationId], references: [id])
  period           String
  actualReturnMc   Int?
  expectedReturnMc Int?
  varianceMc       Int?
  notes            String?
  isAdvisory       Boolean                @default(true)
  recordedBy       String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([companyId, allocationId, period])
  @@index([companyId, allocationId])
}

model CaAuditEvent {
  id         String         @id @default(uuid())
  companyId  String
  poolId     String?
  pool       CaCapitalPool? @relation(fields: [poolId], references: [id])
  actorId    String
  action     String
  objectType String?
  objectId   String?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime       @default(now())

  @@index([companyId, poolId])
  @@index([companyId, createdAt])
}

// ─── Phase 37: Global Operations ─────────────────────────────────────────────

enum GoEntityType {
  HEADQUARTERS
  REGIONAL_OFFICE
  SUBSIDIARY
  BRANCH
  REPRESENTATIVE_OFFICE
  JOINT_VENTURE
}

enum GoOperationalStatus {
  PLANNING
  ACTIVE
  SUSPENDED
  CLOSING
  CLOSED
}

enum GoRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GoComplianceStatus {
  COMPLIANT
  UNDER_REVIEW
  NON_COMPLIANT
  REMEDIATION
}

model GoRegion {
  id          String              @id @default(uuid())
  companyId   String
  company     Company             @relation("GoCompany", fields: [companyId], references: [id])
  name        String
  code        String
  description String?
  timeZone    String?
  currency    String              @default("USD")
  status      GoOperationalStatus @default(ACTIVE)
  managerId   String?
  isAdvisory  Boolean             @default(false)
  createdBy   String
  approvedBy  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  countries   GoCountry[]
  entities    GoOperatingEntity[]
  kpis        GoRegionalKpi[]
  risks       GoRegionalRisk[]
  budgets     GoRegionalBudget[]
  auditEvents GoAuditEvent[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

model GoCountry {
  id         String   @id @default(uuid())
  companyId  String
  regionId   String
  region     GoRegion @relation(fields: [regionId], references: [id])
  name       String
  isoCode    String
  currency   String
  timeZone   String?
  isAdvisory Boolean  @default(false)
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entities GoOperatingEntity[]

  @@unique([companyId, regionId, isoCode])
  @@index([companyId, regionId])
}

model GoOperatingEntity {
  id                 String              @id @default(uuid())
  companyId          String
  regionId           String
  region             GoRegion            @relation(fields: [regionId], references: [id])
  countryId          String?
  country            GoCountry?          @relation(fields: [countryId], references: [id])
  name               String
  code               String
  entityType         GoEntityType        @default(BRANCH)
  status             GoOperationalStatus @default(PLANNING)
  currency           String              @default("USD")
  timeZone           String?
  address            String?
  registrationNumber String?
  managerId          String?
  parentEntityId     String?
  parentEntity       GoOperatingEntity?  @relation("GoEntityParent", fields: [parentEntityId], references: [id])
  childEntities      GoOperatingEntity[] @relation("GoEntityParent")
  isAdvisory         Boolean             @default(false)
  registeredBy       String
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  complianceRecords GoComplianceRecord[]
  auditEvents       GoAuditEvent[]

  @@unique([companyId, code])
  @@index([companyId, regionId, status])
}

model GoRegionalKpi {
  id           String   @id @default(uuid())
  companyId    String
  regionId     String
  region       GoRegion @relation(fields: [regionId], references: [id])
  name         String
  description  String?
  currentValue String?
  targetValue  String?
  unit         String?
  period       String?
  isAdvisory   Boolean  @default(true)
  recordedBy   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, regionId])
}

model GoRegionalRisk {
  id          String      @id @default(uuid())
  companyId   String
  regionId    String
  region      GoRegion    @relation(fields: [regionId], references: [id])
  title       String
  description String?
  riskLevel   GoRiskLevel @default(MEDIUM)
  category    String?
  mitigation  String?
  status      String      @default("OPEN")
  isAdvisory  Boolean     @default(true)
  raisedBy    String
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([companyId, regionId])
}

model GoRegionalBudget {
  id            String   @id @default(uuid())
  companyId     String
  regionId      String
  region        GoRegion @relation(fields: [regionId], references: [id])
  fiscalYear    Int
  fiscalQuarter Int?
  allocatedMc   Int
  forecastedMc  Int?
  actualMc      Int?
  currency      String   @default("USD")
  isAdvisory    Boolean  @default(true)
  createdBy     String
  approvedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, regionId, fiscalYear, fiscalQuarter])
  @@index([companyId, regionId])
}

model GoComplianceRecord {
  id         String             @id @default(uuid())
  companyId  String
  entityId   String
  entity     GoOperatingEntity  @relation(fields: [entityId], references: [id])
  framework  String
  status     GoComplianceStatus @default(UNDER_REVIEW)
  notes      String?
  dueDate    DateTime?
  reviewedBy String?
  resolvedBy String?
  isAdvisory Boolean            @default(true)
  createdBy  String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([companyId, entityId])
}

model GoFxRate {
  id           String   @id @default(uuid())
  companyId    String
  fromCurrency String
  toCurrency   String
  rateMc       Int
  effectiveAt  DateTime
  source       String?
  isAdvisory   Boolean  @default(true)
  createdBy    String
  createdAt    DateTime @default(now())

  @@index([companyId, fromCurrency, toCurrency, effectiveAt])
}

model GoAuditEvent {
  id         String             @id @default(uuid())
  companyId  String
  regionId   String?
  region     GoRegion?          @relation(fields: [regionId], references: [id])
  entityId   String?
  entity     GoOperatingEntity? @relation(fields: [entityId], references: [id])
  actorId    String
  action     String
  objectType String?
  objectId   String?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime           @default(now())

  @@index([companyId, regionId])
  @@index([companyId, createdAt])
}

// ------------------------------------------------------
// PHASE 38: Foundation Intelligence
// ------------------------------------------------------

enum FiDatasetStatus {
  DRAFT
  VALIDATING
  VALIDATED
  REJECTED
  ARCHIVED
}

enum FiTrainingJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum FiModelStatus {
  EXPERIMENTAL
  EVALUATED
  APPROVED
  PRODUCTION
  RETIRED
}

enum FiEvalResult {
  PASS
  FAIL
  INCONCLUSIVE
}

model FiDataset {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation("FiCompany", fields: [companyId], references: [id])
  name            String
  description     String?
  version         String          @default("1.0.0")
  status          FiDatasetStatus @default(DRAFT)
  sourceRef       String?
  recordCount     Int?
  sizeBytes       Int?
  provenance      String?
  hasSecrets      Boolean         @default(false)
  isAdvisory      Boolean         @default(true)
  createdBy       String
  validatedBy     String?
  rejectedBy      String?
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  trainingJobs FiTrainingJob[]
  auditEvents  FiAuditEvent[]

  @@unique([companyId, name, version])
  @@index([companyId, status])
}

model FiTrainingJob {
  id                 String              @id @default(uuid())
  companyId          String
  datasetId          String
  dataset            FiDataset           @relation(fields: [datasetId], references: [id])
  name               String
  description        String?
  jobType            String              @default("FINE_TUNE")
  baseModelRef       String?
  hyperparams        Json?
  resourceLimitCpu   Int?
  resourceLimitMemMb Int?
  status             FiTrainingJobStatus @default(QUEUED)
  startedAt          DateTime?
  completedAt        DateTime?
  errorMessage       String?
  isAdvisory         Boolean             @default(true)
  createdBy          String
  cancelledBy        String?
  idempotencyKey     String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  checkpoints   FiCheckpoint[]
  modelVersions FiModelVersion[]

  @@index([companyId, status])
}

model FiCheckpoint {
  id          String        @id @default(uuid())
  companyId   String
  jobId       String
  job         FiTrainingJob @relation(fields: [jobId], references: [id])
  step        Int
  epochPct    Int?
  loss        String?
  metrics     Json?
  artifactRef String?
  isAdvisory  Boolean       @default(true)
  createdBy   String
  createdAt   DateTime      @default(now())

  @@index([companyId, jobId])
}

model FiModelVersion {
  id              String           @id @default(uuid())
  companyId       String
  jobId           String?
  job             FiTrainingJob?   @relation(fields: [jobId], references: [id])
  family          String
  version         String
  status          FiModelStatus    @default(EXPERIMENTAL)
  description     String?
  artifactRef     String?
  parentVersionId String?
  parentVersion   FiModelVersion?  @relation("FiVersionLineage", fields: [parentVersionId], references: [id])
  childVersions   FiModelVersion[] @relation("FiVersionLineage")
  isAdvisory      Boolean          @default(true)
  proposedBy      String
  approvedBy      String?
  approvedAt      DateTime?
  retiredBy       String?
  retiredAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  evaluations FiEvaluation[]

  @@unique([companyId, family, version])
  @@index([companyId, status])
}

model FiEvaluation {
  id             String         @id @default(uuid())
  companyId      String
  modelVersionId String
  modelVersion   FiModelVersion @relation(fields: [modelVersionId], references: [id])
  benchmarkName  String
  result         FiEvalResult   @default(INCONCLUSIVE)
  score          String?
  notes          String?
  isAdvisory     Boolean        @default(true)
  evaluatedBy    String
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([companyId, modelVersionId])
}

model FiAuditEvent {
  id         String     @id @default(uuid())
  companyId  String
  datasetId  String?
  dataset    FiDataset? @relation(fields: [datasetId], references: [id])
  actorId    String
  action     String
  objectType String?
  objectId   String?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime   @default(now())

  @@index([companyId, datasetId])
  @@index([companyId, createdAt])
}

// ─── Phase 39: R&D Flywheel ───────────────────────────────────────────────────

enum RdPortfolioStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum RdInitiativeStatus {
  PROPOSED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RdCapabilityMaturity {
  NONE
  EMERGING
  DEVELOPING
  MATURE
  LEADING
}

enum RdFeedbackType {
  PRODUCT_OUTCOME
  CUSTOMER_INSIGHT
  MODEL_PERFORMANCE
  RESEARCH_FINDING
  MARKET_SIGNAL
}

model RdPortfolio {
  id          String            @id @default(uuid())
  companyId   String
  company     Company           @relation("RdCompany", fields: [companyId], references: [id])
  name        String
  description String?
  status      RdPortfolioStatus @default(ACTIVE)
  ownerId     String?
  isAdvisory  Boolean           @default(false)
  createdBy   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  initiatives RdInitiative[]
  auditEvents RdAuditEvent[]

  @@unique([companyId, name])
  @@index([companyId, status])
}

model RdInitiative {
  id              String             @id @default(uuid())
  companyId       String
  portfolioId     String
  portfolio       RdPortfolio        @relation(fields: [portfolioId], references: [id])
  title           String
  description     String?
  status          RdInitiativeStatus @default(PROPOSED)
  priority        Int                @default(50)
  researchRef     String?
  modelRef        String?
  productRef      String?
  estimatedCostMc Int?
  actualCostMc    Int?
  isAdvisory      Boolean            @default(true)
  proposedBy      String
  approvedBy      String?
  approvedAt      DateTime?
  completedAt     DateTime?
  idempotencyKey  String             @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  capabilities  RdCapabilityLink[]
  feedbackItems RdFeedbackItem[]

  @@index([companyId, portfolioId, status])
}

model RdCapability {
  id          String               @id @default(uuid())
  companyId   String
  name        String
  description String?
  domain      String?
  maturity    RdCapabilityMaturity @default(NONE)
  isAdvisory  Boolean              @default(true)
  assessedBy  String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  links RdCapabilityLink[]

  @@unique([companyId, name])
  @@index([companyId, domain])
}

model RdCapabilityLink {
  id           String       @id @default(uuid())
  companyId    String
  initiativeId String
  initiative   RdInitiative @relation(fields: [initiativeId], references: [id])
  capabilityId String
  capability   RdCapability @relation(fields: [capabilityId], references: [id])
  createdBy    String
  createdAt    DateTime     @default(now())

  @@unique([initiativeId, capabilityId])
  @@index([companyId, initiativeId])
}

model RdFeedbackItem {
  id           String         @id @default(uuid())
  companyId    String
  initiativeId String?
  initiative   RdInitiative?  @relation(fields: [initiativeId], references: [id])
