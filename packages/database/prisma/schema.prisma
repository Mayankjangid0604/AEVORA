model MpModelHealth {
  id           String   @id @default(uuid())
  companyId    String
  modelId      String
  status       String   @default("UNKNOWN")
  p50LatencyMs Int?
  p95LatencyMs Int?
  errorRateBps Int      @default(0)
  successCount Int      @default(0)
  failureCount Int      @default(0)
  recordedAt   DateTime @default(now())

  company Company @relation("MpModelHealthCompany", fields: [companyId], references: [id])
  model   MpModel @relation(fields: [modelId], references: [id])
}

model MpRoutePolicy {
  id                  String   @id @default(uuid())
  companyId           String
