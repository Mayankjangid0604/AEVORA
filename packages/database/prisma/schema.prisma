  company  Company    @relation("MpProvHealthCompany", fields: [companyId], references: [id])
  provider MpProvider @relation(fields: [providerId], references: [id])
}

model MpModel {
  id                   String        @id @default(uuid())
  companyId            String
  providerId           String
  modelIdentifier      String
  displayName          String
  modelFamily          String?
  modelType            String        @default("TEXT_GENERATION")
  contextWindow        Int           @default(4096)
  modality             String        @default("TEXT")
