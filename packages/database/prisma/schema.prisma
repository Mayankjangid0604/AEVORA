model WorkerProfile {
  id               String          @id @default(uuid())
  employeeId       String          @unique
  employee         Employee        @relation("WorkerProfile", fields: [employeeId], references: [id])
  workerType       WorkerType      @default(HUMAN)
  managerId        String?
  manager          WorkerProfile?  @relation("ReportsTo", fields: [managerId], references: [id])
  directReports    WorkerProfile[] @relation("ReportsTo")
  autonomyLevel    AutonomyLevel   @default(MANUAL)
  onboardingAt     DateTime?
  offboardedAt     DateTime?
  // AI-specific configuration
  aiModel          String?
  aiProvider       String?
  aiSystemRole     String?
  aiCapabilities   Json            @default("[]")
  aiTools          Json            @default("[]")
  aiMemoryScope    String?         @default("COMPANY_SCOPED")
  aiBudgetLimit    Int?
  aiCostTracking   Int             @default(0)
  // Compensation band
  compensationBand String?
  // Workload
  activeTaskCount  Int             @default(0)
  capacityLimit    Int             @default(10)
