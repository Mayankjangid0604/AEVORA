enum WeEventCategory {
  COMMODITY_PRICE
  FX_MOVEMENT
  INTEREST_RATE
  INFLATION
  GEOPOLITICAL
  TECHNOLOGY
  SUPPLY_CHAIN
  REGULATORY
  MARKET_SHOCK
  CUSTOM
}

enum WeEventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WeEventSource {
  MOCK
  HISTORICAL
  LIVE
  WHAT_IF
}

enum WeIndicatorType {
  OIL_PRICE_BRENT
  OIL_PRICE_WTI
  GOLD_PRICE
  USD_INR
  EUR_USD
  GBP_USD
  INTEREST_RATE_BASE
  INFLATION_RATE
  GDP_GROWTH
  UNEMPLOYMENT_RATE
  CUSTOM
}

// Raw normalized external event — describes what happened in the world
// Never mutates company data directly
model WeWorldEvent {
  id             String                @id @default(cuid())
  companyId      String
  category       WeEventCategory
  severity       WeEventSeverity
  source         WeEventSource         @default(MOCK)
  title          String
  description    String
  rawData        Json
  normalizedData Json
  idempotencyKey String
  occurredAt     DateTime
  processedAt    DateTime?
  createdAt      DateTime              @default(now())
  company        Company               @relation(fields: [companyId], references: [id])
  indicators     WeEconomicIndicator[]

  @@unique([companyId, idempotencyKey])
  @@index([companyId, category])
  @@index([companyId, occurredAt])
}

// Individual measurable data points — time series
model WeEconomicIndicator {
  id            String          @id @default(cuid())
  companyId     String
  worldEventId  String?
  indicatorType WeIndicatorType
  value         Float
  unit          String
  previousValue Float?
  deltaPercent  Float?
  recordedAt    DateTime
  source        WeEventSource   @default(MOCK)
  notes         String?
  createdAt     DateTime        @default(now())
  company       Company         @relation(fields: [companyId], references: [id])
  worldEvent    WeWorldEvent?   @relation(fields: [worldEventId], references: [id])

  @@index([companyId, indicatorType, recordedAt])
}

// Current economic conditions snapshot — the live state agents read
model WeMarketState {
  id                    String   @id @default(cuid())
  companyId             String   @unique
  energyCostIndex       Float    @default(1.0)
  usdInrRate            Float?
  eurUsdRate            Float?
  inflationRate         Float    @default(0.0)
  baseInterestRate      Float    @default(0.0)
  gdpGrowthRate         Float?
  supplyCostIndex       Float    @default(1.0)
  logisticsCostIndex    Float    @default(1.0)
  consumerDemandIndex   Float    @default(1.0)
  geopoliticalRiskScore Float    @default(0.0)
  lastUpdatedAt         DateTime @default(now())
  lastEventId           String?
  tickCount             Int      @default(0)
  company               Company  @relation(fields: [companyId], references: [id])
}

// Phase 44 Part 2 — Assistant layer (Chairman <-> Assistant <-> CEO) and queued PC automation tasks.
model AssistantMessage {
  id        String       @id @default(cuid())
  companyId String?
  groupId   String?
  group     AevoraGroup? @relation(fields: [groupId], references: [id])
  from      String // CHAIRMAN | ASSISTANT | CEO | EMPLOYEE | SYSTEM
  to        String // CHAIRMAN | ASSISTANT | CEO | DEPARTMENT | BROADCAST
  content   String
  intent    Json?
  result    Json?
  status    String       @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  company   Company?     @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
}

model PcTask {
  id          String    @id @default(cuid())
  companyId   String
  taskType    String // BROWSE | TYPE | CLICK | READ | SCREENSHOT | WHATSAPP | EMAIL_READ
  instruction String
  url         String?
  status      String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  result      String?
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  company     Company   @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
}

// Phase 44 Part 4 — startup ideas evaluated by the CEO before a venture is formed.
model StartupIdea {
  id              String   @id @default(cuid())
  companyId       String
  source          String   @default("CHAIRMAN") // CHAIRMAN | CEO_GENERATED
  title           String
  description     String
  problem         String?
  targetMarket    String?
  estimatedBudget Int? // paise
  status          String   @default("PENDING") // PENDING | EVALUATING | APPROVED | REJECTED | VENTURE_CREATED
  ceoEvaluation   String?
  ceoScore        Int? // 1-10
  ceoQuestion     String?
  chairmanReply   String?
  ventureId       String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id])
  venture         Venture? @relation(fields: [ventureId], references: [id])

  @@index([companyId, status])
  @@index([companyId, createdAt])
}

// Phase 44 Part 5 — PIXEL's Instagram posts and weekly content calendars (ISO week).
model ContentPost {
  id                  String    @id @default(cuid())
  companyId           String
  createdByEmployeeId String?
  platform            String    @default("INSTAGRAM")
  contentType         String
  caption             String
  hashtags            String[]
  imagePrompt         String?
  imageDescription    String?
  status              String    @default("DRAFT") // DRAFT | APPROVED | POSTED
  scheduledFor        DateTime?
  postedAt            DateTime?
  weekNumber          Int?
  year                Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  company             Company   @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([companyId, weekNumber, year])
}

model ContentCalendar {
  id          String   @id @default(cuid())
  companyId   String
  weekNumber  Int
  year        Int
  theme       String
  posts       Json
  generatedAt DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, weekNumber, year])
  @@index([companyId, year])
}

// ─── Project staffing (2026-09-28) ────────────────────────────────────────────
// Who works on which client project. releasedAt set when the project ends — the person becomes idle
// and is reused for the next project instead of hiring again.
model ClientProjectStaff {
  id         String    @id @default(uuid())
  companyId  String
  projectId  String
  employeeId String
  roleTitle  String
  shared     Boolean   @default(false) // true = no free person, work split with their other project(s)
  assignedAt DateTime  @default(now())
  releasedAt DateTime?

  @@index([companyId, releasedAt])
  @@index([projectId])
  @@index([employeeId, releasedAt])
}

// Chairman-set cap per role ("seats"). No row = DEFAULT_ROLE_SEATS. The CEO never hires past it;
// when demand exceeds seats the Assistant tells the Chairman.
model RoleSeat {
  id        String   @id @default(uuid())
  companyId String
  roleTitle String
  seats     Int
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, roleTitle])
}

// One row per alert sent to the Chairman, so the same shortage isn't mailed every loop.
model ChairmanAlert {
  id         String    @id @default(uuid())
  companyId  String
  key        String
  subject    String
  body       String
  emailedAt  DateTime?
  readAt     DateTime?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([companyId, key, createdAt])
}

// Rooms of the 3D office and how many desk chairs each has (reported by the office when it loads).
// A department's room chairs = how many people the CEO may have in it. Full room → Chairman adds desks/floors.
model OfficeRoom {
  id        String   @id @default(uuid())
  companyId String
  key       String // zone key, e.g. ENGINEERING_IT
  name      String // e.g. "ENGINEERING / IT"
  chairs    Int
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, key])
}

// A demo website built for a lead and hosted on Vercel. Deleted after DEMO_TTL_DAYS without a reply.
model DemoSite {
  id              String    @id @default(uuid())
  companyId       String
  leadId          String
  vercelProjectId String?
  projectName     String
  url             String? // clean production alias only (https://<project>.vercel.app) — never the deployment URL
  status          String    @default("BUILDING") // BUILDING | LIVE | FAILED | DELETED
  error           String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, status, createdAt])
  @@index([leadId])
}

// Everything the company emails the Chairman is a thread here (portal "Chairman Mail"); the Chairman replies by
// email or in the portal (text or voice) and the Assistant acts on it.
model ChairmanMail {
  id             String                @id @default(uuid())
  companyId      String
  ref            String                @unique // AEV-1234, shown in the subject so email replies find their thread
  event          String
  category       String
  title          String
  body           String // the full email text
  data           Json                  @default("{}")
  status         String                @default("OPEN") // OPEN | REPLIED | CLOSED
  emailMessageId String?
  emailedAt      DateTime?
  readAt         DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  messages       ChairmanMailMessage[]

  @@index([companyId, status, createdAt])
  @@index([emailMessageId])
}

model ChairmanMailMessage {
  id             String       @id @default(uuid())
  mailId         String
  mail           ChairmanMail @relation(fields: [mailId], references: [id], onDelete: Cascade)
  from           String // CHAIRMAN | ASSISTANT
  channel        String // EMAIL | PORTAL_TEXT | PORTAL_VOICE
  text           String
  emailMessageId String?      @unique // dedupe replies read from the inbox
  createdAt      DateTime     @default(now())

  @@index([mailId, createdAt])
}

/// Customer complaints and reviews (Customer Support screens). Logged by the Chairman/support; rating 1-5 for reviews.
model CustomerFeedback {
  id           String         @id @default(uuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])
  kind         FeedbackKind
  customerName String
  clientId     String?
  leadId       String?
  subject      String
  details      String?
  rating       Int? // 1-5 (reviews); null for complaints without a rating
  status       FeedbackStatus @default(OPEN)
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?

  @@index([companyId, kind, createdAt])
}

enum FeedbackKind {
  COMPLAINT
  REVIEW
}

enum FeedbackStatus {
  OPEN
  RESOLVED
}

/// Statutory filing calendar the Chairman maintains (GST, TDS, ROC, …) for the Legal & Compliance screens.
