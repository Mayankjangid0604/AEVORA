  verified       Boolean          @default(false)
  verifiedBy     String?
  verifiedAt     DateTime?
  confidence     Int              @default(50)
  notes          String?
  isAdvisory     Boolean          @default(true)
  createdAt      DateTime         @default(now())

  company Company @relation("MpModelCapCompany", fields: [companyId], references: [id])
  model   MpModel @relation(fields: [modelId], references: [id])

  @@unique([modelId, capabilityType])
}

model MpModelVersion {
  id              String            @id @default(uuid())
  companyId       String
  modelId         String
  version         String
  providerVersion String?
  deploymentState MpDeploymentState @default(REGISTERED)
  configuration   Json              @default("{}")
  releaseNotes    String?
  predecessorId   String?
