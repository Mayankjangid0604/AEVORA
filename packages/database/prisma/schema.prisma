  actualCostMc        Int?
  isAdvisory          Boolean            @default(true)
  environment         String             @default("SANDBOX")
  requestHash         String?
  createdAt           DateTime           @default(now())

  company Company @relation("MpInferenceCompany", fields: [companyId], references: [id])
  model   MpModel @relation(fields: [modelId], references: [id])

  @@index([companyId, modelId])
  @@index([companyId, createdAt])
}

model MpKillSwitch {
  id            String            @id @default(uuid())
  companyId     String
  scope         MpKillSwitchScope
  providerId    String?
  modelId       String?
