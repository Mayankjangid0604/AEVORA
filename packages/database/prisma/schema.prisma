enum MpProviderType {
  ANTHROPIC
  OPENAI
  GOOGLE
  MISTRAL
  COHERE
  LOCAL
  SELF_HOSTED
  AEVORA_INTERNAL
  CUSTOM
}

enum MpProviderStatus {
  ACTIVE
  DEGRADED
  UNAVAILABLE
  DISABLED
}

enum MpModelStatus {
  DISCOVERED
  REGISTERED
  ACTIVE
  DEGRADED
  DISABLED
  RETIRED
}

enum MpCapabilityType {
  TEXT_GENERATION
  STRUCTURED_OUTPUT
  EMBEDDINGS
  TOOL_USE
  LONG_CONTEXT
  CODE
  REASONING
  VISION
  AUDIO
  MULTIMODAL
  CLASSIFICATION
  SUMMARIZATION
  EXTRACTION
}

enum MpDeploymentState {
  REGISTERED
  EVALUATING
  APPROVED
  DEPLOYED
  ACTIVE
  DEPRECATED
  RETIRED
}

enum MpInferenceOutcome {
  SUCCESS
  FAILURE
  TIMEOUT
  FALLBACK_USED
  BLOCKED
}

enum MpKillSwitchScope {
  PROVIDER
