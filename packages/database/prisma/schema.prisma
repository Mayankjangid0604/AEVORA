model ImprovementSignal {
  id                String   @id @default(uuid())
  companyId         String
  modelVersionId    String
  signalType        String // ACCURACY_DEGRADATION, REGRESSION, DRIFT, FEEDBACK_DISAGREEMENT, LATENCY_DEGRADATION
  severity          String // LOW, MEDIUM, HIGH, CRITICAL
  metric            String
  observedValue     Float
  baselineValue     Float
  evidenceReference String?
  status            String   @default("OPEN") // OPEN, REVIEWING, ADDRESSED, DISMISSED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company      Company      @relation(fields: [companyId], references: [id])
  modelVersion ModelVersion @relation(fields: [modelVersionId], references: [id])
}

model ResearchHypothesis {
  id                  String   @id @default(uuid())
  companyId           String
  modelFamilyId       String
  problemStatement    String
  hypothesis          String
  expectedImprovement String
  successCriteria     String
  evidenceReferences  Json     @default("[]")
  status              String   @default("PROPOSED") // PROPOSED, ACCEPTED, EXPERIMENTING, VALIDATED, FAILED, SUPERSEDED
  creatorId           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  modelFamily     ModelFamily      @relation(fields: [modelFamilyId], references: [id])
  experimentPlans ExperimentPlan[]
}

model ExperimentPlan {
  id                   String   @id @default(uuid())
  researchHypothesisId String
  baselineVersionId    String
  candidateVersionId   String? // Set after training
  variablesChanged     Json     @default("[]")
  metrics              Json     @default("[]")
  successThresholds    Json     @default("{}")
  regressionThresholds Json     @default("{}")
  computeBudget        Int
  maxRuntimeMs         Int
  datasetVersionId     String
  status               String   @default("PLANNED") // PLANNED, RUNNING, EVALUATING, COMPLETED, FAILED
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  hypothesis       ResearchHypothesis @relation(fields: [researchHypothesisId], references: [id])
  baselineVersion  ModelVersion       @relation("ExperimentBaseline", fields: [baselineVersionId], references: [id])
  candidateVersion ModelVersion?      @relation("ExperimentCandidate", fields: [candidateVersionId], references: [id])
  datasetVersion   DatasetVersion     @relation(fields: [datasetVersionId], references: [id])
  modelComparison  ModelComparison?
  Company          Company?           @relation(fields: [companyId], references: [id])
  companyId        String?
}

model ModelComparison {
  id                 String   @id @default(uuid())
  experimentPlanId   String   @unique
  baselineVersionId  String
  candidateVersionId String
  accuracyChange     Float?
  latencyChange      Float?
  regressionDetected Boolean  @default(false)
  regressionDetails  Json     @default("{}")
  overallResult      String // PASS, FAIL
  createdAt          DateTime @default(now())

  experimentPlan ExperimentPlan @relation(fields: [experimentPlanId], references: [id])
}

