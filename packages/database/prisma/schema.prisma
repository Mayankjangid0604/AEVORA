generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  PAUSED
  SUSPENDED
  CLOSED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  ON_HOLD
  SUSPENDED
  TERMINATED
}

model Chairman {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  credentialHash   String?
  credentialSalt   String?
  hashAlgorithm    String?
  workFactor       Int?
  groups           AevoraGroup[]
  companies        Company[]
  connectedDevices ConnectedDevice[]
  chairmanCommands ChairmanCommand[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model AevoraGroup {
  id                String             @id @default(uuid())
  name              String
  description       String?
  status            CompanyStatus      @default(ACTIVE)
  chairmanId        String
  chairman          Chairman           @relation(fields: [chairmanId], references: [id])
  companies         Company[]
  assistantMessages AssistantMessage[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Company {
  id                         String                      @id @default(uuid())
  name                       String
  legalName                  String?
  description                String?
  status                     CompanyStatus               @default(ACTIVE)
  groupId                    String?
  group                      AevoraGroup?                @relation(fields: [groupId], references: [id])
  chairmanId                 String
  chairman                   Chairman                    @relation(fields: [chairmanId], references: [id])
  departments                Department[]
  roles                      Role[] // Company-specific roles
  employees                  Employee[]
  realMoneyAccount           RealMoneyAccount?
  acWallet                   ACWallet?
  goals                      Goal[]
  connectedDevices           ConnectedDevice[]
  tasks                      Task[]
  clients                    Client[]
  inquiries                  ClientInquiry[]
  opportunities              Opportunity[]
  projects                   Project[]
  operationalAlerts          OperationalAlert[]
  trainingPrograms           TrainingProgram[]
  managementDecisions        ManagementDecision[]
  ceoAutonomousDecisions     CeoAutonomousDecision[]
  revenueRecords             RevenueRecord[]
  projectCosts               ProjectCost[]
  payrollRuns                PayrollRun[]
  companyExpenses            CompanyExpense[]
  companyBudgets             CompanyBudget[]
  departmentBudgets          DepartmentBudget[]
  projectBudgets             ProjectBudget[]
  conversations              Conversation[]
  meetings                   Meeting[]
  notifications              Notification[]
  employeeRelationships      EmployeeRelationship[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  ChairmanFundingRecord      ChairmanFundingRecord[]
  KnowledgeRecord            KnowledgeRecord[]
  intelligenceSessions       IntelligenceSession[]
  decisionProposals          DecisionProposal[]
  assistanceRequests         AssistanceRequest[]
  researchProposals          ResearchProposal[]
  researchProjects           ResearchProject[]
  trainingJobs               TrainingJob[]
  experimentPlans            ExperimentPlan[]
  improvementSignals         ImprovementSignal[]
  researchHypotheses         ResearchHypothesis[]
  modelVersions              ModelVersion[]
  modelFamilies              ModelFamily[]
  datasetVersions            DatasetVersion[]
  TrainingConfiguration      TrainingConfiguration[]
  ComputeWorker              ComputeWorker[]
  ModelCapability            ModelCapability[]
  Dataset                    Dataset[]
  BenchmarkSuite             BenchmarkSuite[]
  PromotionGateRecord        PromotionGateRecord[]
  ModelArtifact              ModelArtifact[]
  SimulationState            SimulationState?
  ProviderIntegration        ProviderIntegration[]
  ApprovalRequest            ApprovalRequest[]
  Invoice                    Invoice[]
  IntegrationAuditLog        IntegrationAuditLog[]
  contracts                  Contract[]
  paymentEvents              PaymentEvent[]
  productionCapabilities     ProductionCapability[]
  companyIntegrations        CompanyIntegration[]
  secretVaults               SecretVault[]
  killSwitches               KillSwitchConfig[]
  externalEventLogs          ExternalEventLog[]
  communicationLogs          CommunicationLog[]
  productionState            ProductionRolloutState      @default(DISABLED)
  productionAllowlists       ProductionAllowlist[]
  productionTransactionLimit ProductionTransactionLimit?
  // Phase 26 relations
  salesLeads                 SalesLead[]
  targetAccounts             TargetAccount[]
  salesActivities            SalesActivity[]
  qualificationRecords       QualificationRecord[]
  salesAuditEvents           SalesAuditEvent[]
  // Phase 27 relations
  brandProfile               BrandProfile?
  brandGuidelines            BrandGuideline[]
  marketPersonas             MarketPersona[]
  marketResearch             MarketResearch[]
  marketingStrategies        MarketingStrategy[]
  marketingCampaigns         MarketingCampaign[]
  marketingContents          MarketingContent[]
  contentCalendarEntries     ContentCalendarEntry[]
  marketingAnalytics         MarketingAnalytics[]
  marketingAuditEvents       MarketingAuditEvent[]
  marketingAgentConfigs      MarketingAgentConfig[]
  // Phase 25 relations
  customerOnboardings        CustomerOnboarding[]
  customerAcceptances        CustomerAcceptance[]
  billingMilestones          BillingMilestone[]
  customerHealthRecords      CustomerHealthRecord[]
  customerCommunications     CustomerCommunication[]
  customerAuditEvents        CustomerAuditEvent[]
  // Phase 29 relations
  hiringRequests             HiringRequest[]             @relation("CompanyHiringRequests")
  aiProvisioningRequests     AIProvisioningRequest[]     @relation("CompanyAIProvisioning")
  workforcePlans             WorkforcePlan[]             @relation("CompanyWorkforcePlans")
  workforceAuditEvents       WorkforceAuditEvent[]       @relation("CompanyWorkforceAudit")
  // Phase 28 relations
  financialPeriods           FinancialPeriod[]           @relation("CompanyFinancialPeriods")
  financialAccounts          FinancialAccount[]          @relation("CompanyFinancialAccounts")
  journalEntries             JournalEntry[]              @relation("CompanyJournalEntries")
  bills                      Bill[]                      @relation("CompanyBills")
  financePaymentRequests     FinancePaymentRequest[]     @relation("CompanyFinancePaymentRequests")
  financialForecasts         FinancialForecast[]         @relation("CompanyFinancialForecasts")
  financialReconciliations   FinancialReconciliation[]   @relation("CompanyFinancialReconciliations")
  financialAuditEvents       FinancialAuditEvent[]       @relation("CompanyFinancialAuditEvents")
  cfoRecommendations         CFORecommendation[]         @relation("CompanyCFORecommendations")
  // Phase 30 relations
  strategicPlans             StrategicPlan[]
  strategicMilestones        StrategicMilestone[]
  companyObjectives          CompanyObjective[]
  companyKPIs                CompanyKPI[]
  healthSnapshots            CompanyHealthSnapshot[]
  managementCycles           ManagementCycle[]
  executiveDecisions         ExecutiveDecision[]
  companyRisks               CompanyRisk[]
  companyOpportunities       CompanyOpportunity[]
  escalationRecords          EscalationRecord[]
  resourceAllocations        ResourceAllocationRecord[]
  organizationalMemory       OrganizationalMemory[]
  managementAuditEvents      ManagementAuditEvent[]
  // Phase 31 relations
  strategicThemes            StrategicTheme[]
  strategicInitiatives       StrategicInitiative[]
  strategicOptions           StrategicOption[]
  strategicScenarios         StrategicScenario[]
  strategicForecasts         StrategicForecast[]
  strategyReviewCycles       StrategyReviewCycle[]
  strategicExperiments       StrategicExperiment[]
  // Phase 32 relations
  labProjects                LabProject[]                @relation("LabProjectCompany")
  resQuestions               ResQuestion[]               @relation("ResQuestionCompany")
  resHypotheses              ResHypothesis[]             @relation("ResHypothesisCompany")
  labExperiments             LabExperiment[]             @relation("LabExperimentCompany")
  labExperimentRuns          LabExperimentRun[]          @relation("LabRunCompany")
  labResults                 LabResult[]                 @relation("LabResultCompany")
  labEvaluations             LabEvaluation[]             @relation("LabEvaluationCompany")
  labFindings                LabFinding[]                @relation("LabFindingCompany")
  labEvidenceItems           LabEvidenceItem[]           @relation("LabEvidenceCompany")
  labReproductions           LabReproduction[]           @relation("LabReproductionCompany")
  labRecommendations         LabRecommendation[]         @relation("LabRecommendationCompany")
  // Phase 33 relations
  mpProviders                MpProvider[]                @relation("MpProviderCompany")
  mpProviderHealth           MpProviderHealth[]          @relation("MpProvHealthCompany")
  mpModels                   MpModel[]                   @relation("MpModelCompany")
  mpModelCapabilities        MpModelCapability[]         @relation("MpModelCapCompany")
  mpModelVersions            MpModelVersion[]            @relation("MpModelVersionCompany")
  mpModelHealth              MpModelHealth[]             @relation("MpModelHealthCompany")
  mpRoutePolicies            MpRoutePolicy[]             @relation("MpRoutePolicyCompany")
  mpFallbackChains           MpFallbackChain[]           @relation("MpFallbackChainCompany")
  mpInferenceExecutions      MpInferenceExecution[]      @relation("MpInferenceCompany")
  mpKillSwitches             MpKillSwitch[]              @relation("MpKillSwitchCompany")
  mpPromptTemplates          MpPromptTemplate[]          @relation("MpPromptTemplCompany")
  mpPromptVersions           MpPromptTemplateVersion[]   @relation("MpPromptVersionCompany")
  mpEmbeddingModels          MpEmbeddingModel[]          @relation("MpEmbeddingCompany")
  // Phase 34 relations
  pfProducts                 PfProduct[]                 @relation("PfProductCompany")
  pfProductIdeas             PfProductIdea[]             @relation("PfIdeaCompany")
  pfProductAuditEvents       PfProductAuditEvent[]       @relation("PfAuditCompany")
  // Phase 35 relations
  businessUnits              BusinessUnit[]              @relation("BuCompany")
  // Phase 36 relations
  capitalPools               CaCapitalPool[]             @relation("CaCompany")
  // Phase 37 relations
  goRegions                  GoRegion[]                  @relation("GoCompany")
  // Phase 38 relations
  fiDatasets                 FiDataset[]                 @relation("FiCompany")
  // Phase 39 relations
  rdPortfolios               RdPortfolio[]               @relation("RdCompany")
  // Phase 40 relations
  aeObjectives               AeEnterpriseObjective[]     @relation("AeCompany")
  aeOperatingCycles          AeOperatingCycle[]          @relation("AeCycleCompany")
  aeChairmanDecisions        AeChairmanDecision[]        @relation("AeDecisionCompany")
  // Phase 41 relations
  researchResults            ResearchResult[]
  outreachDrafts             OutreachDraft[]
  outreachResponses          OutreachResponse[]
  // Phase 41: World Engine
  worldEvents                WeWorldEvent[]
  economicIndicators         WeEconomicIndicator[]
  marketState                WeMarketState?
  leadGenRuns                LeadGenRun[]
  outreachCampaigns          OutreachCampaign[]
  outreachScripts            OutreachScript[]
  discoveryCalls             DiscoveryCall[]
  inboundMessages            InboundMessage[]
  clientProjects             ClientProject[]
  survivalConfig             SurvivalConfig?
  survivalEvents             SurvivalEvent[]
  voiceSessions              VoiceSession[]
  voiceCommands              VoiceCommand[]
  ventures                   Venture[]
  ceoReviews                 CeoReview[]
  leadGenConfig              LeadGenConfig?
  weeklyReports              WeeklyReport[]
  ceoQuestions               CeoQuestion[]
  assistantMessages          AssistantMessage[]
  pcTasks                    PcTask[]
  startupIdeas               StartupIdea[]
  contentPosts               ContentPost[]
  contentCalendars           ContentCalendar[]
  officeLocations            OfficeLocation[]
  salesTargets               SalesTarget[]
  customerFeedback           CustomerFeedback[]
  complianceFilings          ComplianceFiling[]
  currencyRates              CurrencyRate[]
  chairmanCommands           ChairmanCommand[]
  CeoFinancialAuthority      CeoFinancialAuthority[]
  CeoFinancialDecision       CeoFinancialDecision[]

  // Phase X relations
  performanceEvaluations PerformanceEvaluation[] @relation("CompanyEvals")
  successionPlans        SuccessionPlan[]        @relation("CompanySuccessionPlans")
  // OODA Operating Loop
  operatingLoopCycles    OperatingLoopCycle[]
  ClientMeeting          ClientMeeting[]
}

enum RoleAccessLevel {
  STANDARD
  MANAGEMENT
  SYSTEM
  CHAIRMAN
}

model Department {
  id                     String                  @id @default(uuid())
  name                   String
  status                 DepartmentStatus        @default(ACTIVE)
  companyId              String
  company                Company                 @relation(fields: [companyId], references: [id])
  employees              Employee[]
  goals                  Goal[]
  conversations          Conversation[]
  meetings               Meeting[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  DepartmentBudget       DepartmentBudget[]
  KnowledgeRecord        KnowledgeRecord[]
  locations              OfficeLocation[]
  StrategicInitiative    StrategicInitiative[]
  CompanyKPI             CompanyKPI[]
  performanceEvaluations PerformanceEvaluation[]
  successionPlans        SuccessionPlan[]
  tasks                  Task[]                  @relation("DepartmentTasks")
}

model Role {
  id              String           @id @default(uuid())
  title           String
  description     String?
  level           Int              @default(1)
  accessLevel     RoleAccessLevel  @default(STANDARD)
  permissions     Json             @default("[]") // Array of strings e.g. ["MANAGE_EMPLOYEES"]
  status          RoleStatus       @default(ACTIVE)
  companyId       String? // If null, it's a global/template role
  company         Company?         @relation(fields: [companyId], references: [id])
  employees       Employee[]
  successionPlans SuccessionPlan[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Employee {
  id                         String                       @id @default(uuid())
  name                       String
  identitySeed               String
  credentialHash             String?
  credentialSalt             String?
  hashAlgorithm              String?
  workFactor                 Int?
  companyId                  String
  company                    Company                      @relation(fields: [companyId], references: [id])
  departmentId               String
  department                 Department                   @relation(fields: [departmentId], references: [id])
  roleId                     String
  role                       Role                         @relation(fields: [roleId], references: [id])
  acWallet                   ACWallet?
  status                     EmployeeStatus               @default(ACTIVE)
  salary                     Int                          @default(0) // Integer AC value per period
  hireDate                   DateTime                     @default(now())
  terminationDate            DateTime?
  performance                Int                          @default(50) // 0-100 metric
  reliability                Int                          @default(50) // 0-100 metric
  experience                 Int                          @default(0)
  activity                   EmployeeActivity             @default(IDLE)
  availability               EmployeeAvailability         @default(AVAILABLE)
  skills                     EmployeeSkill[]
  history                    EmploymentHistory[]
  agent                      Agent?
  goals                      Goal[]
  assignedTasks              Task[]                       @relation("AssignedTasks")
  taskResults                TaskResult[]                 @relation("WorkerTaskResults")
  performanceRecord          EmployeePerformance?
  projectAssignments         ProjectAssignment[]
  taskReviews                TaskReview[]
  trainings                  EmployeeTraining[]
  proposedDecisions          ManagementDecision[]         @relation("ProposedDecisions")
  targetDecisions            ManagementDecision[]         @relation("TargetDecisions")
  issuedDiscipline           EmployeeDisciplinaryAction[] @relation("IssuedDiscipline")
  receivedDiscipline         EmployeeDisciplinaryAction[] @relation("ReceivedDiscipline")
  conversations              ConversationParticipant[]
  meetings                   MeetingParticipant[]
  notifications              Notification[]
  relationshipsA             EmployeeRelationship[]       @relation("RelationshipA")
  relationshipsB             EmployeeRelationship[]       @relation("RelationshipB")
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  PayrollEntry               PayrollEntry[]
  createdKnowledge           KnowledgeRecord[]            @relation("CreatedKnowledge")
  approvedKnowledge          KnowledgeRecord[]            @relation("ApprovedKnowledge")
  KnowledgeValidation        KnowledgeValidation[]
  intelligenceSessions       IntelligenceSession[]
  proposedDecisions1         DecisionProposal[]           @relation("DecisionProposer")
  reviewedDecisions          DecisionReview[]             @relation("DecisionReviewer")
  requestedAssistance        AssistanceRequest[]          @relation("AssistanceRequester")
  targetedAssistance         AssistanceRequest[]          @relation("AssistanceTarget")
  proposedResearch           ResearchProposal[]           @relation("ProposalProposer")
  reviewedResearch           ResearchProposal[]           @relation("ProposalReviewer")
  researchProjects           ResearchProject[]            @relation("ProjectOwner")
  researchPerspectives       ResearchPerspective[]
  researchSyntheses          ResearchSynthesis[]
  researchExecutions         ResearchExecution[]
  // Phase 26 relations
  ownedOpportunities         Opportunity[]                @relation("OpportunityOwner")
  assignedLeads              SalesLead[]                  @relation("LeadAssignee")
  ownedAccounts              TargetAccount[]              @relation("AccountOwner")
  salesActivities            SalesActivity[]
  qualificationRecords       QualificationRecord[]
  salesAgentConfig           SalesAgentConfig?
  // Phase 25 relations
  ownedOnboardings           CustomerOnboarding[]         @relation("OnboardingOwner")
  requestedAcceptances       CustomerAcceptance[]         @relation("AcceptanceRequestedBy")
  draftedCommunications      CustomerCommunication[]      @relation("CommDraftedBy")
  // Phase 29 relations
  workerProfile              WorkerProfile?               @relation("WorkerProfile")
  // Phase 30 relations
  ownedObjectives            CompanyObjective[]           @relation("OwnedObjectives")
  ownedKPIs                  CompanyKPI[]                 @relation("OwnedKPIs")
  proposedExecDecisions      ExecutiveDecision[]          @relation("ProposedExecDecisions")
  ownedInitiatives           StrategicInitiative[]        @relation("OwnedInitiatives")
  strategicMilestones        StrategicMilestone[]
  ownedExperiments           StrategicExperiment[]        @relation("OwnedExperiments")
  ownedRisks                 CompanyRisk[]                @relation("OwnedRisks")
  ceoAutonomousDecisions     CeoAutonomousDecision[]
  discoveredRisks            CompanyRisk[]                @relation("DiscoveredRisks")
  ownedOpportunities30       CompanyOpportunity[]         @relation("OwnedOpportunities30")
  createdEscalations         EscalationRecord[]           @relation("EscalatedByEmployee")
  requestedAllocations       ResourceAllocationRecord[]   @relation("RequestedAllocations")
  // Phase 32 relations
  ownedLabProjects           LabProject[]                 @relation("LabProjectOwner")
  ownedResQuestions          ResQuestion[]                @relation("ResQuestionOwner")
  labRunsAsRunner            LabExperimentRun[]           @relation("LabRunRunner")
  labEvaluationsGiven        LabEvaluation[]              @relation("LabEvaluator")
  labFindingsAuthored        LabFinding[]                 @relation("LabFindingAuthor")
  labRecommendationsAuthored LabRecommendation[]          @relation("LabRecommendationAuthor")
  ventureTeams               VentureTeam[]
  voiceProfile               VoiceProfile?
  browserProfile             BrowserProfile?
  browserConversations       BrowserConversation[]

  // Phase 12 relations
  locationId              String?
  location                OfficeLocation?         @relation(fields: [locationId], references: [id])
  CeoFinancialAuthority   CeoFinancialAuthority[]
  CeoFinancialDecision    CeoFinancialDecision[]
  // Phase X relations
  evaluations             PerformanceEvaluation[] @relation("EmployeeEvals")
  evaluationsGiven        PerformanceEvaluation[] @relation("Evaluator")
  successionPlansAsHolder SuccessionPlan[]        @relation("CurrentHolder")
  successionCandidacies   SuccessionCandidate[]   @relation("EmployeeSuccessionCands")

  @@index([companyId])
}

enum EmployeeAvailability {
  AVAILABLE
  BUSY
  ON_BREAK
  ON_HOLD
  SUSPENDED
  OFFLINE
}

model VoiceProfile {
  id                   String   @id @default(uuid())
  employeeId           String   @unique
  employee             Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  provider             String   @default("browser")
  voiceId              String?
  providerVoiceId      String? // Actual external provider voice ID (e.g. ElevenLabs ID)
  voiceFamily          String? // e.g. "sales_confident", "chairman_assistant"
  language             String   @default("en-US")
  accent               String?
  pitch                Float    @default(1.0)
  speakingRate         Float    @default(1.0)
  warmth               Float    @default(1.0)
  authority            Float    @default(1.0)
  energy               Float    @default(1.0)
  formality            Float    @default(1.0)
  stability            Float?
  expressiveness       Float?
  style                String?
  personalityInfluence String?
  enabled              Boolean  @default(true)
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

model EmployeeSkill {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  name        String
  category    String
  proficiency Int      @default(0) // 0-100
  experience  Int      @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmploymentHistory {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  eventType     String // e.g., HIRED, PROMOTED, TRANSFERRED, SALARY_CHANGED
  previousValue String?
  newValue      String?
  actor         String // Who/what performed this action
  reason        String?
  referenceId   String?
  createdAt     DateTime @default(now())
}

model ACWallet {
  id              String          @id @default(uuid())
  balance         Int             @default(0) // Integer representation
  companyId       String?         @unique
  company         Company?        @relation(fields: [companyId], references: [id])
  employeeId      String?         @unique
  employee        Employee?       @relation(fields: [employeeId], references: [id])
  transactionsIn  ACTransaction[] @relation("ToWallet")
  transactionsOut ACTransaction[] @relation("FromWallet")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ACTransaction {
  id             String   @id @default(uuid())
  fromWalletId   String
  fromWallet     ACWallet @relation("FromWallet", fields: [fromWalletId], references: [id])
  toWalletId     String
  toWallet       ACWallet @relation("ToWallet", fields: [toWalletId], references: [id])
  amount         Int // Integer representation
  reason         String
  referenceType  String? // e.g., 'SALARY', 'PURCHASE'
  referenceId    String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([fromWalletId])
  @@index([toWalletId])
}

model RealMoneyAccount {
  id             String                  @id @default(uuid())
  balance        Int                     @default(0) // Smallest integer unit (e.g. cents/paise)
  companyId      String                  @unique
  company        Company                 @relation(fields: [companyId], references: [id])
  transactions   RealMoneyTransaction[]
  revenueRecords RevenueRecord[]
  fundingRecords ChairmanFundingRecord[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
}

model RealMoneyTransaction {
  id             String           @id @default(uuid())
  accountId      String
  account        RealMoneyAccount @relation(fields: [accountId], references: [id])
  amount         Int // Smallest integer unit, positive=credit, negative=debit
  description    String
  referenceType  String? // e.g., 'API_COST', 'DEPOSIT'
  referenceId    String?
  idempotencyKey String?          @unique
  createdAt      DateTime         @default(now())

  @@index([accountId])
}

model CompanyEvent {
  id        String   @id @default(uuid())
  companyId String
  type      String // e.g., 'EMPLOYEE_HIRED', 'PROJECT_STARTED', 'COMPANY_PAUSED'
  payload   Json
  createdAt DateTime @default(now())
}

enum AgentStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum ExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  REJECTED
  TIMEOUT
}

model Agent {
  id            String                 @id @default(uuid())
  employeeId    String                 @unique
  employee      Employee               @relation(fields: [employeeId], references: [id])
  status        AgentStatus            @default(ACTIVE)
  autonomyLevel AutonomyLevel          @default(MANUAL)
  budget        Json                   @default("{}")
  configuration Json // e.g., provider, model, systemInstructions
  executions    AgentExecution[]
  memory        AgentMemoryReference[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

enum AutonomyLevel {
  MANUAL
  ASSISTED
  CONTROLLED
  AUTONOMOUS
  HIGH_AUTONOMY
}

model AgentExecution {
  id              String          @id @default(uuid())
  agentId         String
  agent           Agent           @relation(fields: [agentId], references: [id])
  companyId       String
  employeeId      String
  status          ExecutionStatus @default(RUNNING)
  provider        String
  model           String
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  contextSnapshot Json            @default("{}")
  proposedActions Json            @default("[]")
  acceptedActions Json            @default("[]")
  rejectedActions Json            @default("[]")
  error           String?
}

model AgentMemoryReference {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  type      String // e.g., 'EPISODIC', 'SEMANTIC'
  content   String
  createdAt DateTime @default(now())
}

enum GoalStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum TaskStatus {
  BACKLOG
  READY
  IN_PROGRESS
  BLOCKED
  REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskType {
  STANDARD
  DEPARTMENT_OBJECTIVE
}

enum EmployeeActivity {
  IDLE
  WORKING
  THINKING
  IN_MEETING
  TRAINING
  ON_BREAK
  BLOCKED
  ON_HOLD
  OFFLINE
}

model Goal {
  id           String       @id @default(uuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id])
  employeeId   String?
  employee     Employee?    @relation(fields: [employeeId], references: [id])
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  title        String
  description  String?
  priority     TaskPriority @default(NORMAL)
  status       GoalStatus   @default(DRAFT)
  progress     Int          @default(0) // 0-100
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  dueAt        DateTime?
  completedAt  DateTime?
  tasks        Task[]
  ceoPlan      Json?
  finalReport  String?
}

model Task {
  id                 String       @id @default(uuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id])
  projectId          String?
  project            Project?     @relation(fields: [projectId], references: [id])
  goalId             String?
  goal               Goal?        @relation(fields: [goalId], references: [id])
  assignedEmployeeId String?
  assignedEmployee   Employee?    @relation("AssignedTasks", fields: [assignedEmployeeId], references: [id])
  createdBy          String // actor id
  title              String
  description        String?
  priority           TaskPriority @default(NORMAL)
  status             TaskStatus   @default(BACKLOG)
  progress           Int          @default(0)
  estimatedEffort    Int          @default(1) // Abstract units
  actualEffort       Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  startedAt          DateTime?
  completedAt        DateTime?
  dueAt              DateTime?
  requiredCapability String?

  dependencies         TaskDependency[]      @relation("DependentTask")
  dependentOn          TaskDependency[]      @relation("PrerequisiteTask")
  reviews              TaskReview[]
  result               TaskResult?
  intelligenceSessions IntelligenceSession[]
  assistanceRequests   AssistanceRequest[]
  feedbacks            ModelFeedback[]
  type                 TaskType              @default(STANDARD)
  parentTaskId         String?
  parentTask           Task?                 @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks             Task[]                @relation("SubTasks")
