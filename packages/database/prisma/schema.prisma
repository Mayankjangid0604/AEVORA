  errors          Json          @default("[]")
  logs            Json          @default("[]")
  artifacts       Json          @default("[]")
  environment     String        @default("SANDBOX")
  modelIdentifier String?
  datasetVersion  String?
  randomSeed      String?
  resourceUsed    Json          @default("{}")
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())

  result        LabResult?
  evaluations   LabEvaluation[]
  reproductions LabReproduction[] @relation("OriginalRun")
  reproducedBy  LabReproduction[] @relation("ReproductionRun")

  @@index([companyId, experimentId])
  @@index([companyId, status])
}

// Research Result (immutable after finalization)
model LabResult {
  id           String           @id @default(uuid())
  companyId    String
  company      Company          @relation("LabResultCompany", fields: [companyId], references: [id])
  runId        String           @unique
  run          LabExperimentRun @relation(fields: [runId], references: [id])
  summary      String
  metrics      Json             @default("{}")
  artifacts    Json             @default("[]")
  evidenceType ResEvidenceType  @default(RESULT)
  isAdvisory   Boolean          @default(true)
  finalizedAt  DateTime?
  recordedBy   String
  createdAt    DateTime         @default(now())

  evaluations LabEvaluation[]

  @@index([companyId])
}

// Research Evaluation (distinct evaluation step)
model LabEvaluation {
  id                      String            @id @default(uuid())
  companyId               String
  company                 Company           @relation("LabEvaluationCompany", fields: [companyId], references: [id])
  runId                   String?
  run                     LabExperimentRun? @relation(fields: [runId], references: [id])
  resultId                String?
  result                  LabResult?        @relation(fields: [resultId], references: [id])
  evaluatorId             String
  evaluator               Employee          @relation("LabEvaluator", fields: [evaluatorId], references: [id])
  validity                String            @default("UNKNOWN")
  reproducibility         String            @default("UNKNOWN")
  evidenceQuality         String            @default("UNKNOWN")
  confidence              Int               @default(50)
  limitations             Json              @default("[]")
  alternativeExplanations Json              @default("[]")
  consistentWithPrior     Boolean           @default(true)
  notes                   String?
  isAdvisory              Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([companyId])
}

// Research Finding
model LabFinding {
  id                 String           @id @default(uuid())
  companyId          String
  company            Company          @relation("LabFindingCompany", fields: [companyId], references: [id])
  projectId          String
  project            LabProject       @relation(fields: [projectId], references: [id])
  hypothesisId       String?
  hypothesis         ResHypothesis?   @relation(fields: [hypothesisId], references: [id])
  statement          String
  supportingEvidence Json             @default("[]")
  confidence         Int              @default(50)
  limitations        Json             @default("[]")
  counterEvidence    Json             @default("[]")
  authorId           String
  author             Employee         @relation("LabFindingAuthor", fields: [authorId], references: [id])
  evaluatorId        String?
  status             ResFindingStatus @default(DRAFT)
  isAdvisory         Boolean          @default(true)
  reviewedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([companyId, status])
  @@index([companyId, projectId])
}

// Evidence Item (typed evidence with provenance)
model LabEvidenceItem {
  id               String          @id @default(uuid())
  companyId        String
  company          Company         @relation("LabEvidenceCompany", fields: [companyId], references: [id])
  hypothesisId     String?
  hypothesis       ResHypothesis?  @relation(fields: [hypothesisId], references: [id])
  evidenceType     ResEvidenceType @default(OBSERVATION)
  content          String
  source           String?
  sourceType       String?
  retrievedAt      DateTime?
  contentHash      String?
  provenance       String?
  credibility      Int             @default(50)
  confidence       Int             @default(50)
  isContradicting  Boolean         @default(false)
  recordedBy       String
  processingMethod String?
  isAdvisory       Boolean         @default(true)
  createdAt        DateTime        @default(now())

  @@index([companyId])
  @@index([companyId, hypothesisId])
}

// Reproduction Run
model LabReproduction {
  id                String                 @id @default(uuid())
  companyId         String
  company           Company                @relation("LabReproductionCompany", fields: [companyId], references: [id])
  originalRunId     String
  originalRun       LabExperimentRun       @relation("OriginalRun", fields: [originalRunId], references: [id])
  reproductionRunId String
  reproductionRun   LabExperimentRun       @relation("ReproductionRun", fields: [reproductionRunId], references: [id])
  differences       Json                   @default("{}")
  outcome           ResReproductionOutcome @default(NOT_REPRODUCED)
  notes             String?
  conductedBy       String
  isAdvisory        Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([companyId])
}

// Research Recommendation (feeds Strategy)
model LabRecommendation {
  id           String                  @id @default(uuid())
  companyId    String
  company      Company                 @relation("LabRecommendationCompany", fields: [companyId], references: [id])
  projectId    String
  project      LabProject              @relation(fields: [projectId], references: [id])
  statement    String
  rationale    String
  evidenceRefs Json                    @default("[]")
  confidence   Int                     @default(50)
  strategyLink String?
  status       ResRecommendationStatus @default(DRAFT)
  authorId     String
  author       Employee                @relation("LabRecommendationAuthor", fields: [authorId], references: [id])
  isAdvisory   Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([companyId, status])
}

