# Safe local run: applied on top of .env when the API starts with AEVORA_ENV_OVERRIDE=../../scripts/safe-local.env
# Nothing leaves the machine except the local model (Ollama on localhost) and Chairman notifications/summaries to CHAIRMAN_NOTIFY_EMAIL.
OUTREACH_ENVIRONMENT=SANDBOX
ENABLE_REAL_PRODUCTION_SENDING=false
SALES_AUTO_PROCESS=false
LEAD_GEN_PROVIDER_ENABLED=false
INBOX_ENABLED=false
AGENT_WORK_CYCLES=false
AEVORA_SAFE_MODE=true
