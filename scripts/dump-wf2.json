        "options": {}
      }
    },
    {
      "id": "3b1050a8-5992-4a5b-a6a4-b91472a12dd4",
      "name": "Call n8n workflow : Scrape companies homepage content",
      "disabled": true,
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 1.2,
      "position": [
        1380,
        460
      ],
      "parameters": {
        "name": "scraper",
        "fields": {
          "values": [
            {
              "name": "website",
              "stringValue": "={{ $json.website || $json.websiteUrl }}"
            }
          ]
        },
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "TfwQRZkTBtykx1rM"
        },
        "description": "Call this tool to get scraped data about a website."
      }
    },
    {
      "id": "78ae2393-3744-445a-bf28-6dab1f4a8aec",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -180
      ],
      "parameters": {
        "width": 420,
        "height": 480,
        "content": "# AEVORA Automation #2: Lead Enrichment & Qualification\n\nThis workflow receives lead enrichment requests from AEVORA, connects to the AEVORA dual-path lead enrichment engine, evaluates website health (Path A) and software/automation needs (Path B), and updates existing sales leads in AEVORA CRM.\n\n- Trigger: Webhook / Manual Trigger\n- Path A: Missing, broken, or outdated websites\n- Path B: High-need service businesses missing booking & CRM\n- Output: Saved to SalesLead.metadata.enrichment and LeadGenAudit"
      }
    },
    {
      "id": "bf1987fb-ce72-47c1-a020-6ec41e8731e3",
      "name": "Set company url",
      "disabled": true,
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        760,
        500
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "7ea9933b-5972-4623-9c97-eecf1ce0479d",
              "name": "url",
              "type": "string",
              "value": "={{ $json.website || $json.websiteUrl }}"
            }
          ]
        }
      }
    },
    {
      "id": "f0a86878-8db1-4761-a135-9d7a3caac288",
      "name": "HTML to Markdown",
      "disabled": true,
      "type": "n8n-nodes-base.markdown",
