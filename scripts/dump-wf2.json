    {
      "id": "f53b19c5-dcb9-4239-8be8-122a9e479a55",
      "name": "Webhook Trigger",
      "webhookId": "aevora-enrichment-trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "aevora-enrichment-trigger",
        "responseMode": "onReceived",
        "responseData": "firstEntryJson",
        "options": {}
      }
    },
    {
      "id": "1a2b3c4d-5e6f-4a0b-9c1d-2e3f4a5b6c7d",
      "name": "When clicking \"Execute Workflow\"",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        260,
        200
      ],
      "parameters": {}
    },
    {
      "id": "62d84f70-43a2-43aa-815e-56842230c9b1",
      "name": "Prepare Enrichment Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        100
      ],
      "parameters": {
        "jsCode": "const item = $input.first()?.json || {};\nconst companyId = item.companyId || item.body?.companyId || '9d98b53b-3b79-45b8-9bb9-6cbac171bc3c';\nconst limit = item.limit || item.body?.limit || 20;\nconst leadIds = item.leadIds || item.body?.leadIds || [];\nconst forceRefresh = !!(item.forceRefresh || item.body?.forceRefresh);\nconst apiUrl = item.apiUrl || item.body?.apiUrl || 'http://127.0.0.1:13000';\nconst integrationKey = item.integrationKey || item.body?.integrationKey || 'ca8f298aa67930c302c6a711a0172e90';\n\nreturn [{\n  json: {\n    companyId,\n    limit,\n    leadIds,\n    forceRefresh,\n    apiUrl,\n    integrationKey,\n    timestamp: new Date().toISOString()\n  }\n}];"
      }
    },
    {
      "id": "e451cc56-0cef-4bd8-b13e-210d5ddf3001",
      "name": "Execute AEVORA Dual-Path Lead Enrichment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        820,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiUrl }}/automation/webhook/enrichment",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-integration-key",
              "value": "={{ $json.integrationKey }}"
            },
            {
              "name": "x-company-id",
              "value": "={{ $json.companyId }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"leadIds\": {{ JSON.stringify($json.leadIds) }},\n  \"limit\": {{ $json.limit }},\n  \"forceRefresh\": {{ $json.forceRefresh }}\n}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "90c02c5e-228e-478b-b06d-424dc0c4f9b9",
      "name": "Structured Output Parser",
      "disabled": true,
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1500,
        440
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"Business Area\": {\n    \"type\": \"string\",\n    \"description\": \"Summary of the company's core activities or industry focus.\"\n  },\n  \"Offers or Product\": {\n    \"type\": \"string\",\n    \"description\": \"Summary of the company's main products or services.\"\n  },\n  \"Value Proposition\": {\n    \"type\": \"string\",\n    \"description\": \"Catchphrase or tagline that represents the company's value proposition.\"\n  },\n  \"Business Model\": {\n    \"type\": \"string\",\n    \"description\": \"Description of the company's business model, including revenue generation, key partnerships, or unique aspects.\"\n  },\n  \"Ideal Customer Profile\": {\n    \"type\": \"string\",\n    \"description\": \"Description of the ideal customer profile, based on available information.\"\n  }\n}\n"
      }
    },
    {
      "id": "81392d70-3b36-4014-8239-97ea1d69e522",
      "name": "OpenAI Chat Model",
      "disabled": true,
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        1240,
