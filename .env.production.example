# ==========================================
# AEVORA Production Environment Example
# ==========================================
# DO NOT COMMIT SECRETS TO SOURCE CONTROL
# This is a template. Copy to .env.production on your secure server.
# ==========================================

# 1. Base Setup
NODE_ENV=production
API_PORT=3001

# 2. Domains & Traefik HTTPS Setup
WEB_DOMAIN=aevora.example.com
API_DOMAIN=api.aevora.example.com
ACME_EMAIL=admin@example.com

# 3. Security & CORS
CORS_ORIGINS=https://aevora.example.com
# Generate a secure 64-character JWT secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=super_secure_jwt_secret_placeholder_replace_me

# 4. PostgreSQL Configuration
POSTGRES_USER=aevora_admin
POSTGRES_PASSWORD=super_secure_db_password_placeholder
POSTGRES_DB=aevora_prod
# Connection string for the API (Notice it references the internal Docker hostname 'postgres')
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# 5. Redis Configuration
REDIS_PASSWORD=super_secure_redis_password_placeholder
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Webhook HMAC secrets (REQUIRED - API refuses to start without them)
WEBHOOK_SECRET_PROD=
WEBHOOK_SECRET_SIM=

# Public base URL of the API (client sample links, payment webhooks).
# MUST be replaced with the real public API URL before deploy — otherwise code falls back to localhost:13000.
PUBLIC_API_URL=https://api.yourdomain.com

COMPANY_NAME=Your Company

# Company contact details used in client emails, invoices and AI prompts (placeholders — put real ones in .env).
# Client-facing sends fail with a clear error if name/email/phone are missing. COMPANY_EMAIL falls back to SMTP_USER.
COMPANY_EMAIL=hello@example.com
COMPANY_PHONE=+910000000000
COMPANY_ADDRESS=Your City, State, India

# --- Gate 3: outbound safety (server-side only; never read from requests) ---
# HMAC secret for unsubscribe links (>= 32 chars). Sending fails closed without it. Rotating it invalidates old links.
UNSUBSCRIBE_SECRET=

# Emergency stop for ALL external outbound (email, WhatsApp push, publishing). "true" or any malformed value = stopped.
AEVORA_EMERGENCY_STOP=false
# Public demo-site publishing to Vercel. Off by default; drafting works without it (no demo link).
DEMO_PUBLISHING_ENABLED=false
# Pilot send limits per rolling 24h (0 blocks; malformed blocks).
PILOT_MAX_SENDS_PER_RECIPIENT_PER_DAY=1
PILOT_MAX_SENDS_PER_TENANT_PER_DAY=20
PILOT_MAX_SENDS_GLOBAL_PER_DAY=50
# --- Gate 4A: public customer request form (/request) ---
# Company that receives public requests (single-tenant pilot). Unset or not ACTIVE = the form returns 503 (fail closed).
PUBLIC_INTAKE_COMPANY_ID=
